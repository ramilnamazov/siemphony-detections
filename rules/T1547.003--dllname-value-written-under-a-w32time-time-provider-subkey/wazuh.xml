<group name="sigma,windows,registry_set,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="TargetObject" type="pcre2">(?i)\\Services\\W32Time\\TimeProviders\\</field>
    <field name="TargetObject" type="pcre2">(?i)\\DllName$</field>
    <description>DllName value written under a W32Time time provider subkey</description>
    <mitre>
      <id>T1547.003</id>
    </mitre>
  </rule>
</group>
