FROM logs-*
| WHERE ((TO_LOWER(file.path) LIKE "*.iso:zone.identifier" OR TO_LOWER(file.path) LIKE "*.img:zone.identifier" OR TO_LOWER(file.path) LIKE "*.vhd:zone.identifier" OR TO_LOWER(file.path) LIKE "*.vhdx:zone.identifier" OR TO_LOWER(file.path) LIKE "*.zip:zone.identifier" OR TO_LOWER(file.path) LIKE "*.rar:zone.identifier" OR TO_LOWER(file.path) LIKE "*.7z:zone.identifier" OR TO_LOWER(file.path) LIKE "*.gz:zone.identifier" OR TO_LOWER(file.path) LIKE "*.arj:zone.identifier") AND TO_LOWER(winlog.event_data.Contents) LIKE "*zoneid=3*")
