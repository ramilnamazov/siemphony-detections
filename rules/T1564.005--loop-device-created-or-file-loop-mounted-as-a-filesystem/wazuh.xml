<group name="sigma,linux,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <!-- 6 rules: the Sigma condition ORs across different fields,
       which one rule cannot express. Any one matching is a hit. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="type" type="pcre2">(?i)^EXECVE$</field>
    <field name="a0" type="pcre2">(?i)losetup$</field>
    <description>Loop device created or file loop-mounted as a filesystem (1/6)</description>
    <mitre>
      <id>T1564.005</id>
    </mitre>
  </rule>

