FROM logs-*
| WHERE (((TO_LOWER(process.parent.executable) LIKE "*\\\\forfiles.exe" OR TO_LOWER(process.parent.executable) LIKE "*\\\\pcalua.exe" OR TO_LOWER(process.parent.executable) LIKE "*\\\\scriptrunner.exe") AND (TO_LOWER(process.executable) LIKE "*\\\\powershell.exe" OR TO_LOWER(process.executable) LIKE "*\\\\pwsh.exe" OR TO_LOWER(process.executable) LIKE "*\\\\cmd.exe" OR TO_LOWER(process.executable) LIKE "*\\\\wscript.exe" OR TO_LOWER(process.executable) LIKE "*\\\\cscript.exe" OR TO_LOWER(process.executable) LIKE "*\\\\mshta.exe" OR TO_LOWER(process.executable) LIKE "*\\\\rundll32.exe" OR TO_LOWER(process.executable) LIKE "*\\\\regsvr32.exe" OR TO_LOWER(process.executable) LIKE "*\\\\msiexec.exe" OR TO_LOWER(process.executable) LIKE "*\\\\curl.exe" OR TO_LOWER(process.executable) LIKE "*\\\\bitsadmin.exe" OR TO_LOWER(process.executable) LIKE "*\\\\certutil.exe")) OR (TO_LOWER(process.executable) LIKE "*\\\\ssh.exe" AND (TO_LOWER(process.command_line) LIKE "*proxycommand*" OR TO_LOWER(process.command_line) LIKE "*localcommand*")))
