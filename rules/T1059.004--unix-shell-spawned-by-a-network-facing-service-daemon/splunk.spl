index=* ((Image="*/sh" OR Image="*/bash" OR Image="*/dash" OR Image="*/zsh" OR Image="*/ksh" OR Image="*/ash" OR Image="*/busybox") AND ((ParentImage="*/httpd" OR ParentImage="*/apache2" OR ParentImage="*/nginx" OR ParentImage="*/lighttpd" OR ParentImage="*/mysqld" OR ParentImage="*/mariadbd" OR ParentImage="*/postgres" OR ParentImage="*/redis-server" OR ParentImage="*/memcached" OR ParentImage="*/vsftpd" OR ParentImage="*/proftpd" OR ParentImage="*/smbd") OR (ParentImage="*/php-fpm*" OR ParentImage="*/uwsgi*")))
