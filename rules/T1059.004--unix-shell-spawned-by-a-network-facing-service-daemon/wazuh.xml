<group name="sigma,linux,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(/sh$|/bash$|/dash$|/zsh$|/ksh$|/ash$|/busybox$)</field>
    <field name="ParentImage" type="pcre2">(?i)((/httpd$|/apache2$|/nginx$|/lighttpd$|/mysqld$|/mariadbd$|/postgres$|/redis-server$|/memcached$|/vsftpd$|/proftpd$|/smbd$)|(/php-fpm|/uwsgi))</field>
    <description>Unix shell spawned by a network-facing service daemon</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
  </rule>
</group>
