FROM logs-*
| WHERE (TO_LOWER(process.command_line) LIKE "*systeminfo*" OR TO_LOWER(process.command_line) LIKE "*msinfo32*" OR TO_LOWER(process.command_line) LIKE "*dxdiag*" OR TO_LOWER(process.command_line) LIKE "*get-computerinfo*" OR TO_LOWER(process.command_line) LIKE "*win32_operatingsystem*" OR TO_LOWER(process.command_line) LIKE "*win32_computersystem*" OR TO_LOWER(process.command_line) LIKE "*win32_processor*" OR TO_LOWER(process.command_line) LIKE "*win32_bios*" OR TO_LOWER(process.command_line) LIKE "*csproduct get*" OR TO_LOWER(process.command_line) LIKE "*wmic os get*" OR TO_LOWER(process.command_line) LIKE "*environment]::osversion*" OR TO_LOWER(process.command_line) LIKE "*/v productname*" OR TO_LOWER(process.command_line) LIKE "*windows nt\\\\currentversion*")
