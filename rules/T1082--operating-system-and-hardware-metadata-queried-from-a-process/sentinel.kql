DeviceProcessEvents
| where (ProcessCommandLine contains "systeminfo" or ProcessCommandLine contains "msinfo32" or ProcessCommandLine contains "dxdiag" or ProcessCommandLine contains "Get-ComputerInfo" or ProcessCommandLine contains "Win32_OperatingSystem" or ProcessCommandLine contains "Win32_ComputerSystem" or ProcessCommandLine contains "Win32_Processor" or ProcessCommandLine contains "Win32_BIOS" or ProcessCommandLine contains "csproduct get" or ProcessCommandLine contains "wmic os get" or ProcessCommandLine contains "Environment]::OSVersion" or ProcessCommandLine contains "/v ProductName" or ProcessCommandLine contains "Windows NT\\CurrentVersion")
