DeviceProcessEvents
| where (((ProcessCommandLine contains "reg query" or ProcessCommandLine contains "reg.exe query" or ProcessCommandLine contains "Get-ItemProperty" or ProcessCommandLine contains "Get-ItemPropertyValue") and (ProcessCommandLine contains "HKLM" or ProcessCommandLine contains "HKCU" or ProcessCommandLine contains "HKEY_LOCAL_MACHINE" or ProcessCommandLine contains "HKEY_CURRENT_USER")) and (ProcessCommandLine contains "password" or ProcessCommandLine contains "passwd" or ProcessCommandLine contains "pwd" or ProcessCommandLine contains "credential" or ProcessCommandLine contains "cred" or ProcessCommandLine contains "logon"))
