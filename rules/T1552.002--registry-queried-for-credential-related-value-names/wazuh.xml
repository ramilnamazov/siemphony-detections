<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)(reg query|reg\.exe query|Get-ItemProperty|Get-ItemPropertyValue)</field>
    <field name="CommandLine" type="pcre2">(?i)(HKLM|HKCU|HKEY_LOCAL_MACHINE|HKEY_CURRENT_USER)</field>
    <field name="CommandLine" type="pcre2">(?i)(password|passwd|pwd|credential|cred|logon)</field>
    <description>Registry queried for credential-related value names</description>
    <mitre>
      <id>T1552.002</id>
    </mitre>
  </rule>
</group>
