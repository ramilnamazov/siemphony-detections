<group name="sigma,windows,dns_query,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\powershell\.exe$|\\pwsh\.exe$|\\cscript\.exe$|\\wscript\.exe$|\\mshta\.exe$|\\curl\.exe$|\\certutil\.exe$)</field>
    <field name="QueryName" type="pcre2">(?i)(hooks\.slack\.com$|webhook\.site$)</field>
    <description>Webhook endpoint domain resolved by a script host or transfer tool</description>
    <mitre>
      <id>T1567.004</id>
    </mitre>
  </rule>
</group>
