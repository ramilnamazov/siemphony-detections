<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)(Add-MailboxPermission|Add-RecipientPermission|Add-MailboxFolderPermission|Set-MailboxFolderPermission|Add-ADPermission)</field>
    <description>Exchange mailbox delegate permission granted from a command line</description>
    <mitre>
      <id>T1098.002</id>
    </mitre>
  </rule>
</group>
