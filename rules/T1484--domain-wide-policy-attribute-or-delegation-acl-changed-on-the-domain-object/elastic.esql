FROM logs-*
| WHERE ((event.code == 5136 AND (TO_LOWER(winlog.event_data.ObjectClass) == "domaindns" OR TO_LOWER(winlog.event_data.ObjectClass) == "msds-passwordsettings")) AND (TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "gplink" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "gpoptions" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "lockoutduration" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "lockoutthreshold" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "lockoutobservationwindow" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "maxpwdage" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "minpwdage" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "minpwdlength" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "pwdhistorylength" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "pwdproperties" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "ms-ds-machineaccountquota" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "ntsecuritydescriptor" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "msds-passwordsettingsprecedence" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "msds-lockoutduration" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "msds-lockoutobservationwindow" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "msds-lockoutthreshold" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "msds-minimumpasswordlength" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "msds-passwordhistorylength"))
