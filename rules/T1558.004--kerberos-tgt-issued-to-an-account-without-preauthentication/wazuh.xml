<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)^4768$</field>
    <field name="PreAuthType" type="pcre2">(?i)^0$</field>
    <field name="Status" type="pcre2">(?i)^0x0$</field>
    <field name="TargetUserName" negate="yes" type="pcre2">(?i)\$$</field>
    <description>Kerberos TGT issued to an account without preauthentication</description>
    <mitre>
      <id>T1558.004</id>
    </mitre>
  </rule>
</group>
