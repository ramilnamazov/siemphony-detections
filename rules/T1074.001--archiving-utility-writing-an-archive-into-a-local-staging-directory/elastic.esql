FROM logs-*
| WHERE (((TO_LOWER(process.executable) LIKE "*\\\\7z.exe" OR TO_LOWER(process.executable) LIKE "*\\\\7za.exe" OR TO_LOWER(process.executable) LIKE "*\\\\7zr.exe" OR TO_LOWER(process.executable) LIKE "*\\\\7zg.exe" OR TO_LOWER(process.executable) LIKE "*\\\\7zfm.exe" OR TO_LOWER(process.executable) LIKE "*\\\\rar.exe" OR TO_LOWER(process.executable) LIKE "*\\\\winrar.exe" OR TO_LOWER(process.executable) LIKE "*\\\\tar.exe" OR TO_LOWER(process.executable) LIKE "*\\\\diantz.exe") AND (TO_LOWER(file.path) LIKE "*.7z" OR TO_LOWER(file.path) LIKE "*.rar" OR TO_LOWER(file.path) LIKE "*.zip" OR TO_LOWER(file.path) LIKE "*.cab" OR TO_LOWER(file.path) LIKE "*.tar" OR TO_LOWER(file.path) LIKE "*.gz" OR TO_LOWER(file.path) LIKE "*.tgz")) AND (TO_LOWER(file.path) LIKE "c:\\\\temp\\\\*" OR TO_LOWER(file.path) LIKE "c:\\\\windows\\\\temp\\\\*" OR TO_LOWER(file.path) LIKE "c:\\\\windows\\\\tasks\\\\*" OR TO_LOWER(file.path) LIKE "c:\\\\perflogs\\\\*" OR TO_LOWER(file.path) LIKE "c:\\\\users\\\\public\\\\*" OR TO_LOWER(file.path) LIKE "c:\\\\programdata\\\\*"))
