DeviceProcessEvents
| where (FolderPath endswith "\\powercfg.exe" and ((ProcessCommandLine contains "standby-timeout-ac 0" or ProcessCommandLine contains "standby-timeout-dc 0" or ProcessCommandLine contains "hibernate-timeout-ac 0" or ProcessCommandLine contains "hibernate-timeout-dc 0" or ProcessCommandLine contains "monitor-timeout-ac 0" or ProcessCommandLine contains "monitor-timeout-dc 0" or ProcessCommandLine contains "disk-timeout-ac 0" or ProcessCommandLine contains "disk-timeout-dc 0") or (ProcessCommandLine contains "-hibernate off" or ProcessCommandLine contains "/hibernate off" or ProcessCommandLine contains "–hibernate off" or ProcessCommandLine contains "—hibernate off" or ProcessCommandLine contains "―hibernate off" or ProcessCommandLine contains "-h off" or ProcessCommandLine contains "/h off" or ProcessCommandLine contains "–h off" or ProcessCommandLine contains "—h off" or ProcessCommandLine contains "―h off")))
