<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <!-- 2 rules: the Sigma condition ORs across different fields,
       which one rule cannot express. Any one matching is a hit. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\vmrun\.exe$|\\VBoxManage\.exe$)</field>
    <field name="CommandLine" type="pcre2">(?i)( list| showvminfo)</field>
    <description>Hypervisor CLI or cmdlet used to list virtual machines (1/2)</description>
    <mitre>
      <id>T1673</id>
    </mitre>
  </rule>

  <rule id="100001" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\powershell\.exe$|\\pwsh\.exe$)</field>
    <field name="CommandLine" type="pcre2">(?i)Get-VM</field>
    <description>Hypervisor CLI or cmdlet used to list virtual machines (2/2)</description>
    <mitre>
      <id>T1673</id>
    </mitre>
  </rule>
</group>
