<group name="sigma,linux,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(/arecord$|/parecord$)</field>
    <description>Dedicated audio-capture binary executed on Linux</description>
    <mitre>
      <id>T1123</id>
    </mitre>
  </rule>
</group>
