FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*\\\\wscript.exe" OR TO_LOWER(process.executable) LIKE "*\\\\cscript.exe" OR TO_LOWER(process.executable) LIKE "*\\\\mshta.exe" OR TO_LOWER(process.executable) LIKE "*\\\\rundll32.exe") AND (TO_LOWER(process.command_line) LIKE "*.svg*" OR TO_LOWER(process.command_line) LIKE "*.svgz*"))
