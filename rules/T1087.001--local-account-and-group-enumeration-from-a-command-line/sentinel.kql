DeviceProcessEvents
| where (((((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") and (ProcessCommandLine contains " user" or ProcessCommandLine contains " localgroup")) and not ((ProcessCommandLine contains " /do" or ProcessCommandLine contains " -do"))) or (ProcessCommandLine contains "Get-LocalUser" or ProcessCommandLine contains "Get-LocalGroup")) or (FolderPath endswith "\\wmic.exe" and ProcessCommandLine contains "useraccount"))
