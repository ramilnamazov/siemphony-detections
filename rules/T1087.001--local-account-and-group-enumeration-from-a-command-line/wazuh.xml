<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <!-- 3 rules: the Sigma condition ORs across different fields,
       which one rule cannot express. Any one matching is a hit. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\net\.exe$|\\net1\.exe$)</field>
    <field name="CommandLine" type="pcre2">(?i)( user| localgroup)</field>
    <field name="CommandLine" negate="yes" type="pcre2">(?i)( /do| -do)</field>
    <description>Local account and group enumeration from a command line (1/3)</description>
    <mitre>
      <id>T1087.001</id>
    </mitre>
  </rule>

  <rule id="100001" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)(Get-LocalUser|Get-LocalGroup)</field>
    <description>Local account and group enumeration from a command line (2/3)</description>
    <mitre>
      <id>T1087.001</id>
    </mitre>
  </rule>

  <rule id="100002" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)\\wmic\.exe$</field>
    <field name="CommandLine" type="pcre2">(?i)useraccount</field>
    <description>Local account and group enumeration from a command line (3/3)</description>
    <mitre>
      <id>T1087.001</id>
    </mitre>
  </rule>
</group>
