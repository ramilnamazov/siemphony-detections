DeviceProcessEvents
| where (((FolderPath endswith "/openssl" and ProcessCommandLine contains " enc") or ((FolderPath endswith "/gpg" or FolderPath endswith "/gpg1" or FolderPath endswith "/gpg2") and (ProcessCommandLine contains "--symmetric" or ProcessCommandLine contains "--cipher-algo" or ProcessCommandLine contains " -c "))) or (ProcessCommandLine contains "aes-128-cbc" or ProcessCommandLine contains "aes-192-cbc" or ProcessCommandLine contains "aes-256-cbc" or ProcessCommandLine contains "aes-256-ctr" or ProcessCommandLine contains "aes-256-gcm" or ProcessCommandLine contains "-aes128" or ProcessCommandLine contains "-aes192" or ProcessCommandLine contains "-aes256" or ProcessCommandLine contains "chacha20" or ProcessCommandLine contains "-des3" or ProcessCommandLine contains "-rc4" or ProcessCommandLine contains " rc4 "))
