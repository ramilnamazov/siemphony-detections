<group name="sigma,linux,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <!-- 3 rules: the Sigma condition ORs across different fields,
       which one rule cannot express. Any one matching is a hit. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="type" type="pcre2">(?i)^PATH$</field>
    <field name="name" type="pcre2">(?i)/etc/pam\.d/</field>
    <description>PAM configuration or module directory written on Linux (1/3)</description>
    <mitre>
      <id>T1556.003</id>
    </mitre>
  </rule>

  <rule id="100001" level="5">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="type" type="pcre2">(?i)^PATH$</field>
    <field name="name" type="pcre2">(?i)/lib/security/</field>
    <description>PAM configuration or module directory written on Linux (2/3)</description>
    <mitre>
      <id>T1556.003</id>
    </mitre>
  </rule>

  <rule id="100002" level="5">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="type" type="pcre2">(?i)^PATH$</field>
    <field name="name" type="pcre2">(?i)(/lib/x86_64-linux-gnu/security/|/usr/lib/x86_64-linux-gnu/security/)</field>
    <description>PAM configuration or module directory written on Linux (3/3)</description>
    <mitre>
      <id>T1556.003</id>
    </mitre>
  </rule>
</group>
