<group name="sigma,windows,network_connection,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\curl\.exe$|\\wget\.exe$|\\certutil\.exe$|\\powershell\.exe$|\\pwsh\.exe$|\\cscript\.exe$|\\wscript\.exe$|\\mshta\.exe$|\\rundll32\.exe$|\\regsvr32\.exe$|\\python\.exe$|\\pythonw\.exe$|\\winscp\.exe$|\\rclone\.exe$)</field>
    <field name="Initiated" type="pcre2">(?i)^true$</field>
    <field name="DestinationPort" type="pcre2">(?i)(^443$|^8443$|^9443$)</field>
    <description>Non-browser process opening outbound TLS to an external host</description>
    <mitre>
      <id>T1048.002</id>
    </mitre>
  </rule>
</group>
