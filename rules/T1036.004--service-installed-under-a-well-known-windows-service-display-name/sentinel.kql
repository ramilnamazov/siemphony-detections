Event
| where (((Source =~ "Service Control Manager" and EventID == 7045) and (ServiceName =~ "Windows Update" or ServiceName =~ "Windows Defender Antivirus Service" or ServiceName =~ "Print Spooler" or ServiceName =~ "Background Intelligent Transfer Service" or ServiceName =~ "DHCP Client" or ServiceName =~ "DNS Client" or ServiceName =~ "Windows Event Log" or ServiceName =~ "Remote Procedure Call (RPC)" or ServiceName =~ "Task Scheduler" or ServiceName =~ "Windows Management Instrumentation" or ServiceName =~ "Server" or ServiceName =~ "Workstation")) and not ((ImagePath contains "\\Windows\\System32\\" or ImagePath contains "\\Windows\\SysWOW64\\")))
