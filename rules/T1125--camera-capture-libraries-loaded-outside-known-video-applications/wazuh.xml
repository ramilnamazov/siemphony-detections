<group name="sigma,windows,image_load,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="ImageLoaded" type="pcre2">(?i)(\\avicap32\.dll$|\\ksproxy\.ax$|\\mfcaptureengine\.dll$)</field>
    <field name="Image" negate="yes" type="pcre2">(?i)(\\Teams\.exe$|\\ms-teams\.exe$|\\Zoom\.exe$|\\CptHost\.exe$|\\Webex\.exe$|\\slack\.exe$|\\obs64\.exe$|\\obs32\.exe$|\\WindowsCamera\.exe$|\\chrome\.exe$|\\msedge\.exe$|\\firefox\.exe$)</field>
    <description>Camera capture libraries loaded outside known video applications</description>
    <mitre>
      <id>T1125</id>
    </mitre>
  </rule>
</group>
