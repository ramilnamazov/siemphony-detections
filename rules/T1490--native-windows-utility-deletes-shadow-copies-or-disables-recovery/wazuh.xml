<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)((?=.*(?:vssadmin))(?=.*(?:delete shadows)).*|(?=.*(?:wbadmin))(?=.*(?:delete)).*|(?=.*(?:shadowcopy))(?=.*(?:delete)).*|(?=.*(?:bcdedit))(?=.*(?:recoveryenabled)).*|(?=.*(?:reagentc))(?=.*(?:/disable)).*|diskshadow\.exe)</field>
    <description>Native Windows utility deletes shadow copies or disables recovery</description>
    <mitre>
      <id>T1490</id>
    </mitre>
  </rule>
</group>
