FROM logs-*
| WHERE ((TO_LOWER(process.command_line) LIKE "*vssadmin*" AND TO_LOWER(process.command_line) LIKE "*delete shadows*") OR (TO_LOWER(process.command_line) LIKE "*wbadmin*" AND TO_LOWER(process.command_line) LIKE "*delete*") OR (TO_LOWER(process.command_line) LIKE "*shadowcopy*" AND TO_LOWER(process.command_line) LIKE "*delete*") OR (TO_LOWER(process.command_line) LIKE "*bcdedit*" AND TO_LOWER(process.command_line) LIKE "*recoveryenabled*") OR (TO_LOWER(process.command_line) LIKE "*reagentc*" AND TO_LOWER(process.command_line) LIKE "*/disable*") OR TO_LOWER(process.command_line) LIKE "*diskshadow.exe*")
