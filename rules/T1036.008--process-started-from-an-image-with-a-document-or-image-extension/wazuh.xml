<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\.jpg$|\.jpeg$|\.png$|\.gif$|\.bmp$|\.txt$|\.log$|\.pdf$|\.rtf$|\.doc$|\.docx$|\.xls$|\.xlsx$|\.csv$)</field>
    <description>Process started from an image with a document or image extension</description>
    <mitre>
      <id>T1036.008</id>
    </mitre>
  </rule>
</group>
