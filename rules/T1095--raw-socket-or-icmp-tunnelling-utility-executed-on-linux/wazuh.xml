<group name="sigma,linux,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="type" type="pcre2">(?i)^SYSCALL$</field>
    <field name="exe" type="pcre2">(?i)(/hping$|/hping2$|/hping3$|/nping$|/ptunnel$|/ptunnel-ng$|/pingtunnel$|/icmptunnel$)</field>
    <description>Raw-socket or ICMP tunnelling utility executed on Linux</description>
    <mitre>
      <id>T1095</id>
    </mitre>
  </rule>
</group>
