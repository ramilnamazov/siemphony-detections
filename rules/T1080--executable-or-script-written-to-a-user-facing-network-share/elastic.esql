FROM logs-*
| WHERE ((event.code == 5145 AND (TO_LOWER(winlog.event_data.AccessList) LIKE "*%%4417*" OR TO_LOWER(winlog.event_data.AccessList) LIKE "*%%4418*" OR TO_LOWER(winlog.event_data.AccessList) LIKE "*writedata*" OR TO_LOWER(winlog.event_data.AccessList) LIKE "*appenddata*") AND (TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.lnk" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.url" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.exe" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.dll" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.scr" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.msi" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.bat" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.cmd" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.ps1" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.vbs" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.vbe" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.js" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.jse" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.wsf" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.hta" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.jar" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.chm" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.iso")) AND NOT ((TO_LOWER(winlog.event_data.ShareName) LIKE "*\\\\admin$" OR TO_LOWER(winlog.event_data.ShareName) LIKE "*\\\\ipc$" OR TO_LOWER(winlog.event_data.ShareName) LIKE "*\\\\c$" OR TO_LOWER(winlog.event_data.ShareName) LIKE "*\\\\d$" OR TO_LOWER(winlog.event_data.ShareName) LIKE "*\\\\e$" OR TO_LOWER(winlog.event_data.ShareName) LIKE "*\\\\print$" OR TO_LOWER(winlog.event_data.ShareName) LIKE "*\\\\netlogon" OR TO_LOWER(winlog.event_data.ShareName) LIKE "*\\\\sysvol")))
