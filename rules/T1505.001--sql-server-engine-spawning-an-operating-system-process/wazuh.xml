<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="ParentImage" type="pcre2">(?i)\\sqlservr\.exe$</field>
    <field name="Image" negate="yes" type="pcre2">(?i)(\\sqldumper\.exe$|\\fdlauncher\.exe$)</field>
    <description>SQL Server engine spawning an operating system process</description>
    <mitre>
      <id>T1505.001</id>
    </mitre>
  </rule>
</group>
