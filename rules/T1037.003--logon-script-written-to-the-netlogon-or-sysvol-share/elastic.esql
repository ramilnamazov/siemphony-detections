FROM logs-*
| WHERE (event.code == 5145 AND (TO_LOWER(ShareName) LIKE "*\\\\netlogon" OR TO_LOWER(ShareName) LIKE "*\\\\sysvol") AND (TO_LOWER(AccessList) LIKE "*%%4417*" OR TO_LOWER(AccessList) LIKE "*%%4418*" OR TO_LOWER(AccessList) LIKE "*writedata*" OR TO_LOWER(AccessList) LIKE "*appenddata*") AND (TO_LOWER(RelativeTargetName) LIKE "*.bat" OR TO_LOWER(RelativeTargetName) LIKE "*.cmd" OR TO_LOWER(RelativeTargetName) LIKE "*.ps1" OR TO_LOWER(RelativeTargetName) LIKE "*.vbs" OR TO_LOWER(RelativeTargetName) LIKE "*.vbe" OR TO_LOWER(RelativeTargetName) LIKE "*.js" OR TO_LOWER(RelativeTargetName) LIKE "*.jse" OR TO_LOWER(RelativeTargetName) LIKE "*.wsf" OR TO_LOWER(RelativeTargetName) LIKE "*.hta" OR TO_LOWER(RelativeTargetName) LIKE "*.exe" OR TO_LOWER(RelativeTargetName) LIKE "*.dll"))
