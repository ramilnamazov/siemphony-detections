<group name="sigma,windows,registry_set,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="TargetObject" type="pcre2">(?i)\\Control Panel\\Desktop\\SCRNSAVE\.EXE$</field>
    <field name="Details" type="pcre2">(?i)(\\Users\\|\\AppData\\|\\ProgramData\\|\\Windows\\Temp\\|\\PerfLogs\\|\\\$Recycle\.Bin\\)</field>
    <description>Screensaver registry value pointed at a user-writable path</description>
    <mitre>
      <id>T1546.002</id>
    </mitre>
  </rule>
</group>
