DeviceProcessEvents
| where (((FolderPath endswith "/t50" or FolderPath endswith "/mz" or FolderPath endswith "/mausezahn" or FolderPath endswith "/slowhttptest" or FolderPath endswith "/hyenae") or ((FolderPath endswith "/hping" or FolderPath endswith "/hping2" or FolderPath endswith "/hping3" or FolderPath endswith "/nping") and (ProcessCommandLine contains "--flood" or ProcessCommandLine contains "--rand-source" or ProcessCommandLine contains "--faster" or ProcessCommandLine contains "--rate " or ProcessCommandLine contains " -i u"))) or ((FolderPath endswith "/ping" or FolderPath endswith "/ping6") and ProcessCommandLine contains " -f "))
