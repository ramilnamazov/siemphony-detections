FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*/chmod" OR TO_LOWER(process.executable) LIKE "*/install") AND (TO_LOWER(process.command_line) LIKE "*+s*" OR TO_LOWER(process.command_line) LIKE "*4755*" OR TO_LOWER(process.command_line) LIKE "*4777*" OR TO_LOWER(process.command_line) LIKE "*4711*" OR TO_LOWER(process.command_line) LIKE "*4750*" OR TO_LOWER(process.command_line) LIKE "*4700*" OR TO_LOWER(process.command_line) LIKE "*6755*" OR TO_LOWER(process.command_line) LIKE "*6777*" OR TO_LOWER(process.command_line) LIKE "*2755*" OR TO_LOWER(process.command_line) LIKE "*2775*" OR TO_LOWER(process.command_line) LIKE "*2777*"))
