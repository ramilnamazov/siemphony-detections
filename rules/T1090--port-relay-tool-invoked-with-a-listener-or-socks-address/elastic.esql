FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*/socat" OR TO_LOWER(process.executable) LIKE "*/ncat") AND (TO_LOWER(process.command_line) LIKE "*tcp-listen*" OR TO_LOWER(process.command_line) LIKE "*tcp4-listen*" OR TO_LOWER(process.command_line) LIKE "*tcp6-listen*" OR TO_LOWER(process.command_line) LIKE "*udp-listen*" OR TO_LOWER(process.command_line) LIKE "*openssl-listen*" OR TO_LOWER(process.command_line) LIKE "*socks4*" OR TO_LOWER(process.command_line) LIKE "*socks5*" OR TO_LOWER(process.command_line) LIKE "*proxy:*" OR TO_LOWER(process.command_line) LIKE "*--proxy*" OR TO_LOWER(process.command_line) LIKE "*--broker*"))
