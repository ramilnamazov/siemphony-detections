FROM logs-*
| WHERE ((((TO_LOWER(file.path) LIKE "*\\\\microsoft\\\\word\\\\startup\\\\*" AND (TO_LOWER(file.path) LIKE "*.wll" OR TO_LOWER(file.path) LIKE "*.dotm" OR TO_LOWER(file.path) LIKE "*.dot")) OR (TO_LOWER(file.path) LIKE "*\\\\xlstart\\\\*" AND (TO_LOWER(file.path) LIKE "*.xll" OR TO_LOWER(file.path) LIKE "*.xlam" OR TO_LOWER(file.path) LIKE "*.xla" OR TO_LOWER(file.path) LIKE "*.xlsm" OR TO_LOWER(file.path) LIKE "*.xlsb" OR TO_LOWER(file.path) LIKE "*.xls" OR TO_LOWER(file.path) LIKE "*.xltm"))) AND NOT (TO_LOWER(file.path) LIKE "*\\\\~$*")) AND NOT (TO_LOWER(file.path) LIKE "*\\\\personal.xlsb"))
