FROM logs-*
| WHERE (TO_LOWER(file.path) LIKE "*\\\\windows\\\\web\\\\wallpaper\\\\*" OR TO_LOWER(file.path) LIKE "*\\\\windows\\\\web\\\\screen\\\\*" OR TO_LOWER(file.path) LIKE "*\\\\windows\\\\web\\\\4k\\\\*" OR TO_LOWER(file.path) LIKE "*\\\\appdata\\\\roaming\\\\microsoft\\\\windows\\\\themes\\\\*" OR TO_LOWER(file.path) LIKE "*\\\\system32\\\\oobe\\\\info\\\\backgrounds\\\\*" OR TO_LOWER(file.path) LIKE "*\\\\inetpub\\\\wwwroot\\\\*")
