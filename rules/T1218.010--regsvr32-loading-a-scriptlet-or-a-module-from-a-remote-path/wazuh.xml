<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)\\regsvr32\.exe$</field>
    <field name="CommandLine" type="pcre2">(?i)((http://|https://|ftp://|\\\\)|(scrobj\.dll|\.sct))</field>
    <description>Regsvr32 loading a scriptlet or a module from a remote path</description>
    <mitre>
      <id>T1218.010</id>
    </mitre>
  </rule>
</group>
