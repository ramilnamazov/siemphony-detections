FROM logs-*
| WHERE (TO_LOWER(process.executable) LIKE "*\\\\regsvr32.exe" AND ((TO_LOWER(process.command_line) LIKE "*http://*" OR TO_LOWER(process.command_line) LIKE "*https://*" OR TO_LOWER(process.command_line) LIKE "*ftp://*" OR TO_LOWER(process.command_line) LIKE "*\\\\\\\\*") OR (TO_LOWER(process.command_line) LIKE "*scrobj.dll*" OR TO_LOWER(process.command_line) LIKE "*.sct*")))
