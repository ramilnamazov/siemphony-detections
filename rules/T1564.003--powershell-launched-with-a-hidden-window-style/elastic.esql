FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*\\\\powershell.exe" OR TO_LOWER(process.executable) LIKE "*\\\\pwsh.exe") AND (TO_LOWER(process.command_line) LIKE "*-windowstyle hidden*" OR TO_LOWER(process.command_line) LIKE "*/windowstyle hidden*" OR TO_LOWER(process.command_line) LIKE "*–windowstyle hidden*" OR TO_LOWER(process.command_line) LIKE "*—windowstyle hidden*" OR TO_LOWER(process.command_line) LIKE "*―windowstyle hidden*" OR TO_LOWER(process.command_line) LIKE "*-windowstyle h*" OR TO_LOWER(process.command_line) LIKE "*/windowstyle h*" OR TO_LOWER(process.command_line) LIKE "*–windowstyle h*" OR TO_LOWER(process.command_line) LIKE "*—windowstyle h*" OR TO_LOWER(process.command_line) LIKE "*―windowstyle h*" OR TO_LOWER(process.command_line) LIKE "*-win hidden*" OR TO_LOWER(process.command_line) LIKE "*/win hidden*" OR TO_LOWER(process.command_line) LIKE "*–win hidden*" OR TO_LOWER(process.command_line) LIKE "*—win hidden*" OR TO_LOWER(process.command_line) LIKE "*―win hidden*" OR TO_LOWER(process.command_line) LIKE "*-win h*" OR TO_LOWER(process.command_line) LIKE "*/win h*" OR TO_LOWER(process.command_line) LIKE "*–win h*" OR TO_LOWER(process.command_line) LIKE "*—win h*" OR TO_LOWER(process.command_line) LIKE "*―win h*"))
