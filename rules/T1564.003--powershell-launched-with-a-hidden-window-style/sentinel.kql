DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") and (ProcessCommandLine contains "-windowstyle hidden" or ProcessCommandLine contains "/windowstyle hidden" or ProcessCommandLine contains "–windowstyle hidden" or ProcessCommandLine contains "—windowstyle hidden" or ProcessCommandLine contains "―windowstyle hidden" or ProcessCommandLine contains "-windowstyle h" or ProcessCommandLine contains "/windowstyle h" or ProcessCommandLine contains "–windowstyle h" or ProcessCommandLine contains "—windowstyle h" or ProcessCommandLine contains "―windowstyle h" or ProcessCommandLine contains "-win hidden" or ProcessCommandLine contains "/win hidden" or ProcessCommandLine contains "–win hidden" or ProcessCommandLine contains "—win hidden" or ProcessCommandLine contains "―win hidden" or ProcessCommandLine contains "-win h" or ProcessCommandLine contains "/win h" or ProcessCommandLine contains "–win h" or ProcessCommandLine contains "—win h" or ProcessCommandLine contains "―win h"))
