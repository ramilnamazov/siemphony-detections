<group name="sigma,windows,registry_set,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="TargetObject" type="pcre2">(?i)(\\Control\\Lsa\\Authentication Packages|\\Control\\Lsa\\Notification Packages|\\Control\\Lsa\\Security Packages|\\Control\\Lsa\\OSConfig\\Security Packages|\\Control\\LsaExtensionConfig\\)</field>
    <description>Registry write to an LSA package list or LSA extension key</description>
    <mitre>
      <id>T1547.008</id>
      <id>T1547.005</id>
      <id>T1556.002</id>
    </mitre>
  </rule>
</group>
