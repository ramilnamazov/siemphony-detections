<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <!-- 2 rules: the Sigma condition ORs across different fields,
       which one rule cannot express. Any one matching is a hit. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)\\reg\.exe$</field>
    <field name="CommandLine" type="pcre2">(?i)Nls\\Language</field>
    <description>Process queries the system locale via registry lookup or PowerShell (1/2)</description>
    <mitre>
      <id>T1614.001</id>
    </mitre>
  </rule>

  <rule id="100001" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\powershell\.exe$|\\pwsh\.exe$)</field>
    <field name="CommandLine" type="pcre2">(?i)(Get-WinSystemLocale|Get-UICulture|Get-Culture|Get-WinUserLanguageList)</field>
    <description>Process queries the system locale via registry lookup or PowerShell (2/2)</description>
    <mitre>
      <id>T1614.001</id>
    </mitre>
  </rule>
</group>
