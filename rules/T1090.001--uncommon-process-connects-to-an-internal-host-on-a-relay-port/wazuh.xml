<group name="sigma,windows,network_connection,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\rundll32\.exe$|\\regsvr32\.exe$|\\mshta\.exe$|\\wscript\.exe$|\\cscript\.exe$|\\powershell\.exe$|\\pwsh\.exe$)</field>
    <field name="DestinationIp" type="pcre2">(?i)(^10\.|^192\.168\.|^172\.16\.|^172\.17\.|^172\.18\.|^172\.19\.|^172\.20\.|^172\.21\.|^172\.22\.|^172\.23\.|^172\.24\.|^172\.25\.|^172\.26\.|^172\.27\.|^172\.28\.|^172\.29\.|^172\.30\.|^172\.31\.)</field>
    <field name="DestinationPort" type="pcre2">(?i)(^1080$|^1081$|^4444$|^4445$|^5555$|^9050$)</field>
    <description>Uncommon process connects to an internal host on a relay port</description>
    <mitre>
      <id>T1090.001</id>
    </mitre>
  </rule>
</group>
