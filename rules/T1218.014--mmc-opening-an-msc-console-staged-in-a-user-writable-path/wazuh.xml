<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)\\mmc\.exe$</field>
    <field name="CommandLine" type="pcre2">(?i)\.msc</field>
    <field name="CommandLine" type="pcre2">(?i)(\\Users\\|\\AppData\\|\\Downloads\\|\\Desktop\\|\\ProgramData\\|\\Temp\\|\\\\)</field>
    <description>MMC opening an .msc console staged in a user-writable path</description>
    <mitre>
      <id>T1218.014</id>
    </mitre>
  </rule>
</group>
