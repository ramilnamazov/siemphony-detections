<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)^4104$</field>
    <field name="ScriptBlockText" type="pcre2">(?i)(EnumWindows|EnumChildWindows|GetForegroundWindow|GetWindowText|GetWindowTextLength|GetWindowThreadProcessId|MainWindowTitle)</field>
    <description>Window enumeration entry points in a PowerShell script block</description>
    <mitre>
      <id>T1010</id>
    </mitre>
  </rule>
</group>
