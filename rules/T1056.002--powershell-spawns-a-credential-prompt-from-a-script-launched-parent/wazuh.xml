<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\powershell\.exe$|\\pwsh\.exe$)</field>
    <field name="CommandLine" type="pcre2">(?i)(PromptForCredential|Get-Credential|Enter your password|CredentialRequired)</field>
    <field name="ParentImage" type="pcre2">(?i)(\\cmd\.exe$|\\wscript\.exe$|\\cscript\.exe$)</field>
    <description>PowerShell spawns a credential prompt from a script-launched parent</description>
    <mitre>
      <id>T1056.002</id>
    </mitre>
  </rule>
</group>
