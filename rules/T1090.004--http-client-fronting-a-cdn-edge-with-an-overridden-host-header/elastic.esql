FROM logs-*
| WHERE ((((TO_LOWER(process.executable) LIKE "*/curl" OR TO_LOWER(process.executable) LIKE "*/wget" OR TO_LOWER(process.executable) LIKE "*/busybox") AND (TO_LOWER(process.command_line) LIKE "*-h host:*" OR TO_LOWER(process.command_line) LIKE "*-hhost:*" OR TO_LOWER(process.command_line) LIKE "*--header=host:*")) AND TO_LOWER(process.command_line) LIKE "*https://*") AND (TO_LOWER(process.command_line) LIKE "*cloudfront.net*" OR TO_LOWER(process.command_line) LIKE "*azureedge.net*" OR TO_LOWER(process.command_line) LIKE "*fastly.net*" OR TO_LOWER(process.command_line) LIKE "*akamaihd.net*"))
