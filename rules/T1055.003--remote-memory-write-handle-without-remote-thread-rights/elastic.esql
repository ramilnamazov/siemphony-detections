FROM logs-*
| WHERE ((TO_LOWER(winlog.event_data.TargetImage) LIKE "*\\\\explorer.exe" OR TO_LOWER(winlog.event_data.TargetImage) LIKE "*\\\\svchost.exe" OR TO_LOWER(winlog.event_data.TargetImage) LIKE "*\\\\dllhost.exe" OR TO_LOWER(winlog.event_data.TargetImage) LIKE "*\\\\taskhostw.exe" OR TO_LOWER(winlog.event_data.TargetImage) LIKE "*\\\\winlogon.exe" OR TO_LOWER(winlog.event_data.TargetImage) LIKE "*\\\\spoolsv.exe") AND (TO_LOWER(winlog.event_data.GrantedAccess) == "0x1438" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x1428" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x438" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x428" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x38" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x28"))
