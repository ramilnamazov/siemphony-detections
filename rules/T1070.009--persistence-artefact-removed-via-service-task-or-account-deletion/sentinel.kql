DeviceProcessEvents
| where (((((FolderPath endswith "\\sc.exe" and ProcessCommandLine contains " delete ") or (FolderPath endswith "\\schtasks.exe" and (ProcessCommandLine contains "-delete" or ProcessCommandLine contains "/delete" or ProcessCommandLine contains "–delete" or ProcessCommandLine contains "—delete" or ProcessCommandLine contains "―delete"))) or ((FolderPath endswith "\\reg.exe" and ProcessCommandLine contains " delete ") and (ProcessCommandLine contains "\\CurrentVersion\\Run" or ProcessCommandLine contains "\\Image File Execution Options\\" or ProcessCommandLine contains "\\CurrentControlSet\\Services\\"))) or ((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") and (ProcessCommandLine contains " user " and ProcessCommandLine contains "/delete"))) or (ProcessCommandLine contains "Unregister-ScheduledTask" or ProcessCommandLine contains "Remove-LocalUser" or ProcessCommandLine contains "Remove-Service"))
