DeviceProcessEvents
| where ((FolderPath endswith "/cat" or FolderPath endswith "/less" or FolderPath endswith "/more" or FolderPath endswith "/cp" or FolderPath endswith "/scp" or FolderPath endswith "/rsync" or FolderPath endswith "/tar" or FolderPath endswith "/gpg" or FolderPath endswith "/gpg2" or FolderPath endswith "/base64") and (ProcessCommandLine contains ".ssh/id_rsa" or ProcessCommandLine contains ".ssh/id_dsa" or ProcessCommandLine contains ".ssh/id_ecdsa" or ProcessCommandLine contains ".ssh/id_ed25519" or ProcessCommandLine contains ".gnupg" or ProcessCommandLine contains ".pem" or ProcessCommandLine contains ".ppk" or ProcessCommandLine contains ".p12" or ProcessCommandLine contains ".pfx"))
