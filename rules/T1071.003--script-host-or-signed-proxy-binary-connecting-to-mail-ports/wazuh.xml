<group name="sigma,windows,network_connection,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Initiated" type="pcre2">(?i)^true$</field>
    <field name="Image" type="pcre2">(?i)(\\powershell\.exe$|\\pwsh\.exe$|\\wscript\.exe$|\\cscript\.exe$|\\mshta\.exe$|\\rundll32\.exe$|\\regsvr32\.exe$|\\certutil\.exe$|\\curl\.exe$|\\python\.exe$)</field>
    <field name="DestinationPort" type="pcre2">(?i)(^25$|^465$|^587$|^110$|^995$|^143$|^993$)</field>
    <description>Script host or signed proxy binary connecting to mail ports</description>
    <mitre>
      <id>T1071.003</id>
    </mitre>
  </rule>
</group>
