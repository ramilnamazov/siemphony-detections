FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*\\\\runas.exe" AND TO_LOWER(process.command_line) LIKE "*/netonly*") OR ((TO_LOWER(process.command_line) LIKE "*logonuser*" OR TO_LOWER(process.command_line) LIKE "*lsalogonuser*") AND (TO_LOWER(process.command_line) LIKE "*setthreadtoken*" OR TO_LOWER(process.command_line) LIKE "*impersonateloggedonuser*")))
