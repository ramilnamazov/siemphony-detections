FROM logs-*
| WHERE (((TO_LOWER(type) == "path" AND (TO_LOWER(name) LIKE "*/site-packages/*" OR TO_LOWER(name) LIKE "*/dist-packages/*")) AND (TO_LOWER(type) == "path" AND TO_LOWER(name) LIKE "*.pth")) OR (TO_LOWER(type) == "path" AND (TO_LOWER(name) LIKE "*sitecustomize.py" OR TO_LOWER(name) LIKE "*usercustomize.py")))
