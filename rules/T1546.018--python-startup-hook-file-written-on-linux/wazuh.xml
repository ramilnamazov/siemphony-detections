<group name="sigma,linux,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <!-- 2 rules: the Sigma condition ORs across different fields,
       which one rule cannot express. Any one matching is a hit. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="type" type="pcre2">(?i)^PATH$</field>
    <field name="name" type="pcre2">(?i)(/site-packages/|/dist-packages/)</field>
    <field name="type" type="pcre2">(?i)^PATH$</field>
    <field name="name" type="pcre2">(?i)\.pth$</field>
    <description>Python startup hook file written on Linux (1/2)</description>
    <mitre>
      <id>T1546.018</id>
    </mitre>
  </rule>

  <rule id="100001" level="5">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="type" type="pcre2">(?i)^PATH$</field>
    <field name="name" type="pcre2">(?i)(sitecustomize\.py$|usercustomize\.py$)</field>
    <description>Python startup hook file written on Linux (2/2)</description>
    <mitre>
      <id>T1546.018</id>
    </mitre>
  </rule>
</group>
