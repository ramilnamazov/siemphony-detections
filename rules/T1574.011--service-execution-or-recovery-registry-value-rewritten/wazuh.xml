<group name="sigma,windows,registry_set,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="TargetObject" type="pcre2">(?i)\\CurrentControlSet\\Services\\</field>
    <field name="TargetObject" type="pcre2">(?i)(\\ImagePath$|\\FailureCommand$|\\Parameters\\ServiceDll$)</field>
    <description>Service execution or recovery registry value rewritten</description>
    <mitre>
      <id>T1574.011</id>
    </mitre>
  </rule>
</group>
