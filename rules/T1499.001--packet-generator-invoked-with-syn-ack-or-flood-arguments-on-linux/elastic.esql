FROM logs-*
| WHERE ((TO_LOWER(type) == "execve" AND (TO_LOWER(a0) LIKE "*hping" OR TO_LOWER(a0) LIKE "*hping2" OR TO_LOWER(a0) LIKE "*hping3" OR TO_LOWER(a0) LIKE "*nping")) AND ((TO_LOWER(a1) LIKE "*-s*" OR TO_LOWER(a1) LIKE "*--syn*" OR TO_LOWER(a1) LIKE "*-a*" OR TO_LOWER(a1) LIKE "*--ack*" OR TO_LOWER(a1) LIKE "*--flood*") OR (TO_LOWER(a2) LIKE "*-s*" OR TO_LOWER(a2) LIKE "*--syn*" OR TO_LOWER(a2) LIKE "*-a*" OR TO_LOWER(a2) LIKE "*--ack*" OR TO_LOWER(a2) LIKE "*--flood*") OR (TO_LOWER(a3) LIKE "*-s*" OR TO_LOWER(a3) LIKE "*--syn*" OR TO_LOWER(a3) LIKE "*-a*" OR TO_LOWER(a3) LIKE "*--ack*" OR TO_LOWER(a3) LIKE "*--flood*") OR (TO_LOWER(a4) LIKE "*-s*" OR TO_LOWER(a4) LIKE "*--syn*" OR TO_LOWER(a4) LIKE "*-a*" OR TO_LOWER(a4) LIKE "*--ack*" OR TO_LOWER(a4) LIKE "*--flood*")))
