FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*\\\\mavinject.exe" OR TO_LOWER(process.executable) LIKE "*\\\\mavinject32.exe") AND (TO_LOWER(process.command_line) LIKE "*-injectrunning*" OR TO_LOWER(process.command_line) LIKE "*/injectrunning*" OR TO_LOWER(process.command_line) LIKE "*–injectrunning*" OR TO_LOWER(process.command_line) LIKE "*—injectrunning*" OR TO_LOWER(process.command_line) LIKE "*―injectrunning*" OR TO_LOWER(process.command_line) LIKE "*-hmodule*" OR TO_LOWER(process.command_line) LIKE "*/hmodule*" OR TO_LOWER(process.command_line) LIKE "*–hmodule*" OR TO_LOWER(process.command_line) LIKE "*—hmodule*" OR TO_LOWER(process.command_line) LIKE "*―hmodule*"))
