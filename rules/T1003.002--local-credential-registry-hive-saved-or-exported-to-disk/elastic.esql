FROM logs-*
| WHERE (((TO_LOWER(process.command_line) LIKE "* save *" OR TO_LOWER(process.command_line) LIKE "* export *") AND (TO_LOWER(process.command_line) LIKE "*hklm\\\\sam*" OR TO_LOWER(process.command_line) LIKE "*hklm\\\\system*" OR TO_LOWER(process.command_line) LIKE "*hklm\\\\security*" OR TO_LOWER(process.command_line) LIKE "*hklm:\\\\sam*" OR TO_LOWER(process.command_line) LIKE "*hklm:\\\\system*" OR TO_LOWER(process.command_line) LIKE "*hklm:\\\\security*" OR TO_LOWER(process.command_line) LIKE "*\\\\registry\\\\machine\\\\sam*" OR TO_LOWER(process.command_line) LIKE "*\\\\registry\\\\machine\\\\security*")) OR (TO_LOWER(process.command_line) LIKE "*\\\\config\\\\sam*" OR TO_LOWER(process.command_line) LIKE "*\\\\config\\\\system*" OR TO_LOWER(process.command_line) LIKE "*\\\\config\\\\security*" OR TO_LOWER(process.command_line) LIKE "*/config/sam*" OR TO_LOWER(process.command_line) LIKE "*/config/system*" OR TO_LOWER(process.command_line) LIKE "*/config/security*"))
