FROM logs-*
| WHERE (((TO_LOWER(process.executable) LIKE "*\\\\powershell.exe" OR TO_LOWER(process.executable) LIKE "*\\\\pwsh.exe") AND (TO_LOWER(process.command_line) LIKE "*.png*" OR TO_LOWER(process.command_line) LIKE "*.jpg*" OR TO_LOWER(process.command_line) LIKE "*.jpeg*" OR TO_LOWER(process.command_line) LIKE "*.bmp*" OR TO_LOWER(process.command_line) LIKE "*.gif*" OR TO_LOWER(process.command_line) LIKE "*.ico*" OR TO_LOWER(process.command_line) LIKE "*.wav*")) AND (TO_LOWER(process.command_line) LIKE "*getpixel*" OR TO_LOWER(process.command_line) LIKE "*lockbits*" OR TO_LOWER(process.command_line) LIKE "*invoke-psimage*"))
