<group name="sigma,windows,raw_access_thread,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Device" type="pcre2">(?i)(\\Partition0$|\\DR)</field>
    <description>Process opens the whole-disk raw device object bypassing partitions</description>
    <mitre>
      <id>T1542.003</id>
    </mitre>
  </rule>
</group>
