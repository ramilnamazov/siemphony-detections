<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)(findstr|Select-String)</field>
    <field name="CommandLine" type="pcre2">(?i)(password|passwd|pwd=|credential|secret|apikey|api_key|accesskey|connectionstring)</field>
    <description>Filesystem searched for credential strings in files</description>
    <mitre>
      <id>T1552.001</id>
    </mitre>
  </rule>
</group>
