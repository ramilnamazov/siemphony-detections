<group name="sigma,windows,registry_add,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="TargetObject" type="pcre2">(?i)(\\SystemCertificates\\Root\\Certificates\\|\\SystemCertificates\\AuthRoot\\Certificates\\|\\EnterpriseCertificates\\Root\\Certificates\\)</field>
    <field name="Image" negate="yes" type="pcre2">(?i)^C:\\Windows\\System32\\svchost\.exe$</field>
    <description>New subkey created under a trusted root certificate store</description>
    <mitre>
      <id>T1553.004</id>
    </mitre>
  </rule>
</group>
