index=* ((((((type="EXECVE" AND a0="*auditctl") AND (a1="-D" OR (a1="-e" AND a2="0"))) OR (type="EXECVE" AND a0="*systemctl" AND (a1="*stop*" OR a1="*disable*" OR a1="*mask*") AND a2="*auditd*")) OR (type="EXECVE" AND a0="*service" AND a1="*auditd*" AND (a2="*stop*" OR a2="*disable*" OR a2="*mask*"))) OR (type="EXECVE" AND (a0="*pkill" OR a0="*killall") AND a1="*auditd*")) OR (type="PATH" AND (name="*/etc/audit/audit.rules*" OR name="*/etc/audit/audit.conf*" OR name="*/etc/audit/rules.d/*")))
