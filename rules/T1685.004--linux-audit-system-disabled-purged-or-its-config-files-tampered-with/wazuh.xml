    </mitre>
  </rule>

  <rule id="100005" level="5">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="type" type="pcre2">(?i)^PATH$</field>
    <field name="name" type="pcre2">(?i)(/etc/audit/audit\.rules|/etc/audit/audit\.conf|/etc/audit/rules\.d/)</field>
    <description>Linux Audit system disabled, purged or its config files tampered with (6/6)</description>
