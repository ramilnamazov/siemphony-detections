FROM logs-*
| WHERE ((TO_LOWER(TargetImage) LIKE "*\\\\explorer.exe" OR TO_LOWER(TargetImage) LIKE "*\\\\winlogon.exe" OR TO_LOWER(TargetImage) LIKE "*\\\\services.exe" OR TO_LOWER(TargetImage) LIKE "*\\\\svchost.exe" OR TO_LOWER(TargetImage) LIKE "*\\\\dwm.exe") AND (TO_LOWER(GrantedAccess) == "0x1fffff" OR TO_LOWER(GrantedAccess) == "0x1f3fff" OR TO_LOWER(GrantedAccess) == "0x1f2fff" OR TO_LOWER(GrantedAccess) == "0x1f1fff" OR TO_LOWER(GrantedAccess) == "0x1f0fff" OR TO_LOWER(GrantedAccess) == "0x147a" OR TO_LOWER(GrantedAccess) == "0x143a" OR TO_LOWER(GrantedAccess) == "0x47a" OR TO_LOWER(GrantedAccess) == "0x43a" OR TO_LOWER(GrantedAccess) == "0x42a" OR TO_LOWER(GrantedAccess) == "0x2a"))
