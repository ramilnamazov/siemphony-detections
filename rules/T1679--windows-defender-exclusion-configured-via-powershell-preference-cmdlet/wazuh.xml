<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)^4104$</field>
    <field name="ScriptBlockText" type="pcre2">(?i)(Add-MpPreference|Set-MpPreference)</field>
    <field name="ScriptBlockText" type="pcre2">(?i)(-ExclusionPath|-ExclusionExtension|-ExclusionProcess|-ExclusionIpAddress)</field>
    <description>Windows Defender exclusion configured via PowerShell preference cmdlet</description>
    <mitre>
      <id>T1679</id>
    </mitre>
  </rule>
</group>
