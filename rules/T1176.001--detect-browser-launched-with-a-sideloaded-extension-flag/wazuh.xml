<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)(--load-extension=|--disable-extensions-except=|--pack-extension=|--install-chrome-app=)</field>
    <description>Detect browser launched with a sideloaded extension flag</description>
    <mitre>
      <id>T1176.001</id>
    </mitre>
  </rule>
</group>
