DeviceFileEvents
| where ((FolderPath endswith ".scf" or FolderPath endswith ".url" or FolderPath endswith ".library-ms" or FolderPath endswith ".searchConnector-ms") and (FolderPath contains "\\Desktop\\" or FolderPath contains "\\Downloads\\" or FolderPath contains "\\Users\\Public\\" or FolderPath contains "\\Start Menu\\" or FolderPath contains "\\Templates\\" or FolderPath contains "\\AppData\\Local\\Temp\\"))
