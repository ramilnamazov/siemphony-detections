<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\regsvcs\.exe$|\\regasm\.exe$)</field>
    <field name="CommandLine" type="pcre2">(?i)(\\AppData\\Local\\Temp\\|\\AppData\\Roaming\\|\\Downloads\\|\\Users\\Public\\|\\Windows\\Temp\\|\\ProgramData\\|\\\\)</field>
    <description>Detect COM registration utility running a user-writable assembly</description>
    <mitre>
      <id>T1218.009</id>
    </mitre>
  </rule>
</group>
