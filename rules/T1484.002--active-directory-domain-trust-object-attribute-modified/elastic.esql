FROM logs-*
| WHERE ((event.code == 5136 AND TO_LOWER(winlog.event_data.ObjectClass) == "trusteddomain") AND (TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "trustpartner" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "trustdirection" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "trusttype" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "trustattributes" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "msds-trustforesttrustinfo"))
