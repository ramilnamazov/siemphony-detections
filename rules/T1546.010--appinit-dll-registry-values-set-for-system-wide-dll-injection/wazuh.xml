<group name="sigma,windows,registry_set,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="TargetObject" type="pcre2">(?i)(\\Windows NT\\CurrentVersion\\Windows\\AppInit_DLLs$|\\Windows NT\\CurrentVersion\\Windows\\LoadAppInit_DLLs$|\\Windows NT\\CurrentVersion\\Windows\\RequireSignedAppInit_DLLs$)</field>
    <description>AppInit DLL registry values set for system-wide DLL injection</description>
    <mitre>
      <id>T1546.010</id>
    </mitre>
  </rule>
</group>
