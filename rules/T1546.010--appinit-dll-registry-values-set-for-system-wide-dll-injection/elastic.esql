FROM logs-*
| WHERE (TO_LOWER(registry.path) LIKE "*\\\\windows nt\\\\currentversion\\\\windows\\\\appinit_dlls" OR TO_LOWER(registry.path) LIKE "*\\\\windows nt\\\\currentversion\\\\windows\\\\loadappinit_dlls" OR TO_LOWER(registry.path) LIKE "*\\\\windows nt\\\\currentversion\\\\windows\\\\requiresignedappinit_dlls")
