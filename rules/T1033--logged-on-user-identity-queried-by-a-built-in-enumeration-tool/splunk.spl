index=* (Image="*\\whoami.exe" OR (Image="*\\quser.exe" OR Image="*\\qwinsta.exe") OR (Image="*\\query.exe" AND (CommandLine="* user*" OR CommandLine="* session*")) OR ((Image="*\\net.exe" OR Image="*\\net1.exe") AND CommandLine="* user*") OR (CommandLine="*WindowsIdentity]::GetCurrent*" OR CommandLine="*Environment]::UserName*" OR CommandLine="*$env:USERNAME*" OR CommandLine="*Win32_LoggedOnUser*"))
