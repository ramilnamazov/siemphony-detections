FROM logs-*
| WHERE ((event.code == 5145 AND (TO_LOWER(winlog.event_data.ShareName) LIKE "*\\\\c$" OR TO_LOWER(winlog.event_data.ShareName) LIKE "*\\\\admin$" OR TO_LOWER(winlog.event_data.ShareName) LIKE "*\\\\d$" OR TO_LOWER(winlog.event_data.ShareName) LIKE "*\\\\e$")) AND (TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.doc" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.docx" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.xls" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.xlsx" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.ppt" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.pptx" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.pdf" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.zip" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.7z" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.rar" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.pst" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.ost" OR TO_LOWER(winlog.event_data.RelativeTargetName) LIKE "*.kdbx"))
