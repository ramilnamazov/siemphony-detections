<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)^5145$</field>
    <field name="ShareName" type="pcre2">(?i)(\\C\$$|\\ADMIN\$$|\\D\$$|\\E\$$)</field>
    <field name="RelativeTargetName" type="pcre2">(?i)(\.doc$|\.docx$|\.xls$|\.xlsx$|\.ppt$|\.pptx$|\.pdf$|\.zip$|\.7z$|\.rar$|\.pst$|\.ost$|\.kdbx$)</field>
    <description>Document or archive accessed inside a hidden administrative share</description>
    <mitre>
      <id>T1039</id>
    </mitre>
  </rule>
</group>
