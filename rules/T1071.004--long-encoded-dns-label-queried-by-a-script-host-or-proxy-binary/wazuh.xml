<group name="sigma,windows,dns_query,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\powershell\.exe$|\\pwsh\.exe$|\\rundll32\.exe$|\\regsvr32\.exe$|\\mshta\.exe$|\\wscript\.exe$|\\cscript\.exe$|\\nslookup\.exe$|\\certutil\.exe$|\\python\.exe$|\\msbuild\.exe$|\\installutil\.exe$)</field>
    <field name="QueryName" type="pcre2">(?i)^[A-Za-z0-9_-]{40,}\.</field>
    <description>Long encoded DNS label queried by a script host or proxy binary</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>
</group>
