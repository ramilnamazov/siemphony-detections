<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\fwupdate\.exe$|\\afuwin\.exe$|\\afudos\.exe$|\\h2offt\.exe$|\\h2offtwin64\.exe$|\\winflash\.exe$)</field>
    <description>Known BIOS/UEFI firmware flash utility launched</description>
    <mitre>
      <id>T1542.001</id>
    </mitre>
  </rule>
</group>
