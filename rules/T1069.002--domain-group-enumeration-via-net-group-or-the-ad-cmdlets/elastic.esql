FROM logs-*
| WHERE (((TO_LOWER(process.executable) LIKE "*\\\\net.exe" OR TO_LOWER(process.executable) LIKE "*\\\\net1.exe") AND (TO_LOWER(process.command_line) LIKE "* group *" AND TO_LOWER(process.command_line) LIKE "*/domain*")) OR (TO_LOWER(process.command_line) LIKE "*get-adgroup*" OR TO_LOWER(process.command_line) LIKE "*get-adprincipalgroupmembership*" OR TO_LOWER(process.command_line) LIKE "*get-domaingroup*" OR TO_LOWER(process.command_line) LIKE "*get-netgroup*" OR TO_LOWER(process.command_line) LIKE "*dsquery group*" OR TO_LOWER(process.command_line) LIKE "*dsget group*"))
