FROM logs-*
| WHERE (TO_LOWER(process.executable) LIKE "*\\\\clip.exe" AND (((TO_LOWER(process.parent.executable) LIKE "*\\\\cmd.exe" OR TO_LOWER(process.parent.executable) LIKE "*\\\\powershell.exe" OR TO_LOWER(process.parent.executable) LIKE "*\\\\pwsh.exe") AND (TO_LOWER(process.parent.command_line) LIKE "*-c *" OR TO_LOWER(process.parent.command_line) LIKE "*/c *" OR TO_LOWER(process.parent.command_line) LIKE "*–c *" OR TO_LOWER(process.parent.command_line) LIKE "*—c *" OR TO_LOWER(process.parent.command_line) LIKE "*―c *" OR TO_LOWER(process.parent.command_line) LIKE "*-command*" OR TO_LOWER(process.parent.command_line) LIKE "*/command*" OR TO_LOWER(process.parent.command_line) LIKE "*–command*" OR TO_LOWER(process.parent.command_line) LIKE "*—command*" OR TO_LOWER(process.parent.command_line) LIKE "*―command*" OR TO_LOWER(process.parent.command_line) LIKE "*-encodedcommand*" OR TO_LOWER(process.parent.command_line) LIKE "*/encodedcommand*" OR TO_LOWER(process.parent.command_line) LIKE "*–encodedcommand*" OR TO_LOWER(process.parent.command_line) LIKE "*—encodedcommand*" OR TO_LOWER(process.parent.command_line) LIKE "*―encodedcommand*" OR TO_LOWER(process.parent.command_line) LIKE "*-enc *" OR TO_LOWER(process.parent.command_line) LIKE "*/enc *" OR TO_LOWER(process.parent.command_line) LIKE "*–enc *" OR TO_LOWER(process.parent.command_line) LIKE "*—enc *" OR TO_LOWER(process.parent.command_line) LIKE "*―enc *")) OR NOT ((TO_LOWER(process.parent.executable) LIKE "*\\\\explorer.exe" OR TO_LOWER(process.parent.executable) LIKE "*\\\\cmd.exe" OR TO_LOWER(process.parent.executable) LIKE "*\\\\powershell.exe" OR TO_LOWER(process.parent.executable) LIKE "*\\\\pwsh.exe"))))
