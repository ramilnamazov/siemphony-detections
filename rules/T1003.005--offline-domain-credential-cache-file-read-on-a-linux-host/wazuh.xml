<group name="sigma,linux,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)(/var/lib/sss/db/cache|/var/lib/sss/secrets|/var/opt/quest/vas/authcache)</field>
    <description>Offline domain credential cache file read on a Linux host</description>
    <mitre>
      <id>T1003.005</id>
    </mitre>
  </rule>
</group>
