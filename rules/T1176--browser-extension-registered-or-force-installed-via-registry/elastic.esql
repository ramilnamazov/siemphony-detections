FROM logs-*
| WHERE (TO_LOWER(registry.path) LIKE "*\\\\policies\\\\google\\\\chrome\\\\extensioninstallforcelist\\\\*" OR TO_LOWER(registry.path) LIKE "*\\\\policies\\\\google\\\\chrome\\\\extensionsettings\\\\*" OR TO_LOWER(registry.path) LIKE "*\\\\policies\\\\microsoft\\\\edge\\\\extensioninstallforcelist\\\\*" OR TO_LOWER(registry.path) LIKE "*\\\\policies\\\\microsoft\\\\edge\\\\extensionsettings\\\\*" OR TO_LOWER(registry.path) LIKE "*\\\\policies\\\\bravesoftware\\\\brave\\\\extensioninstallforcelist\\\\*" OR TO_LOWER(registry.path) LIKE "*\\\\google\\\\chrome\\\\extensions\\\\*" OR TO_LOWER(registry.path) LIKE "*\\\\microsoft\\\\edge\\\\extensions\\\\*" OR TO_LOWER(registry.path) LIKE "*\\\\chromium\\\\extensions\\\\*" OR TO_LOWER(registry.path) LIKE "*\\\\mozilla\\\\firefox\\\\extensions\\\\*" OR TO_LOWER(registry.path) LIKE "*\\\\nativemessaginghosts\\\\*")
