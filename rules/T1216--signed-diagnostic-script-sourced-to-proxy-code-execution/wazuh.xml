<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)^4104$</field>
    <field name="ScriptBlockText" type="pcre2">(?i)((CL_Invocation\.ps1|CL_LoadAssembly\.ps1|CL_Mutexverifiers\.ps1|UtilityFunctions\.ps1)|(SyncInvoke|LoadAssemblyFromPath|LoadAssemblyFromNS|runAfterCancelProcess|RegSnapin))</field>
    <description>Signed diagnostic script sourced to proxy code execution</description>
    <mitre>
      <id>T1216</id>
    </mitre>
  </rule>
</group>
