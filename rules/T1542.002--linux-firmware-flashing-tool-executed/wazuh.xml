<group name="sigma,linux,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="type" type="pcre2">(?i)^SYSCALL$</field>
    <field name="syscall" type="pcre2">(?i)^execve$</field>
    <field name="exe" type="pcre2">(?i)(/flashrom$|/fwupdmgr$|/fwupdtool$)</field>
    <description>Linux firmware flashing tool executed</description>
    <mitre>
      <id>T1542.002</id>
    </mitre>
  </rule>
</group>
