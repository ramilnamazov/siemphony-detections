FROM logs-*
| WHERE (TO_LOWER(process.executable) LIKE "*\\\\msiexec.exe" AND ((TO_LOWER(process.command_line) LIKE "*http://*" OR TO_LOWER(process.command_line) LIKE "*https://*" OR TO_LOWER(process.command_line) LIKE "*ftp://*" OR TO_LOWER(process.command_line) LIKE "*\\\\\\\\*") OR (TO_LOWER(process.command_line) LIKE "*-y *" OR TO_LOWER(process.command_line) LIKE "*/y *" OR TO_LOWER(process.command_line) LIKE "*–y *" OR TO_LOWER(process.command_line) LIKE "*—y *" OR TO_LOWER(process.command_line) LIKE "*―y *" OR TO_LOWER(process.command_line) LIKE "*-z *" OR TO_LOWER(process.command_line) LIKE "*/z *" OR TO_LOWER(process.command_line) LIKE "*–z *" OR TO_LOWER(process.command_line) LIKE "*—z *" OR TO_LOWER(process.command_line) LIKE "*―z *")))
