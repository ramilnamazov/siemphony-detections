<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)\\msiexec\.exe$</field>
    <field name="CommandLine" type="pcre2">(?i)((http://|https://|ftp://|\\\\)|(-y |/y |–y |—y |―y |-z |/z |–z |—z |―z ))</field>
    <description>Msiexec installing a package or DLL from a remote source</description>
    <mitre>
      <id>T1218.007</id>
    </mitre>
  </rule>
</group>
