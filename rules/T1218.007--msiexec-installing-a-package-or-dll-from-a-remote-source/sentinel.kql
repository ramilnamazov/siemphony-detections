DeviceProcessEvents
| where (FolderPath endswith "\\msiexec.exe" and ((ProcessCommandLine contains "http://" or ProcessCommandLine contains "https://" or ProcessCommandLine contains "ftp://" or ProcessCommandLine contains "\\\\") or (ProcessCommandLine contains "-y " or ProcessCommandLine contains "/y " or ProcessCommandLine contains "–y " or ProcessCommandLine contains "—y " or ProcessCommandLine contains "―y " or ProcessCommandLine contains "-z " or ProcessCommandLine contains "/z " or ProcessCommandLine contains "–z " or ProcessCommandLine contains "—z " or ProcessCommandLine contains "―z ")))
