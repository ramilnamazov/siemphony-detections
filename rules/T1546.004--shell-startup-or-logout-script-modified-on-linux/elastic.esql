FROM logs-*
| WHERE ((TO_LOWER(type) == "path" AND (TO_LOWER(name) LIKE "*.bashrc" OR TO_LOWER(name) LIKE "*.bash_profile" OR TO_LOWER(name) LIKE "*.bash_login" OR TO_LOWER(name) LIKE "*.bash_logout" OR TO_LOWER(name) LIKE "*.bash_aliases" OR TO_LOWER(name) LIKE "*.profile" OR TO_LOWER(name) LIKE "*.zshrc" OR TO_LOWER(name) LIKE "*.zshenv" OR TO_LOWER(name) LIKE "*.zprofile" OR TO_LOWER(name) LIKE "*.zlogin" OR TO_LOWER(name) LIKE "*.zlogout" OR TO_LOWER(name) LIKE "*/etc/profile" OR TO_LOWER(name) LIKE "*/etc/bash.bashrc" OR TO_LOWER(name) LIKE "*/etc/bashrc" OR TO_LOWER(name) LIKE "*/etc/zsh/zshrc" OR TO_LOWER(name) LIKE "*/etc/zsh/zshenv" OR TO_LOWER(name) LIKE "*/etc/zsh/zprofile" OR TO_LOWER(name) LIKE "*/etc/zsh/zlogin" OR TO_LOWER(name) LIKE "*/etc/zsh/zlogout" OR TO_LOWER(name) LIKE "*/etc/zshrc" OR TO_LOWER(name) LIKE "*/etc/zshenv" OR TO_LOWER(name) LIKE "*/etc/zprofile" OR TO_LOWER(name) LIKE "*/etc/zlogin" OR TO_LOWER(name) LIKE "*/etc/zlogout")) OR (TO_LOWER(type) == "path" AND TO_LOWER(name) LIKE "*/etc/profile.d/*"))
