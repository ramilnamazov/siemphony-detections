FROM logs-*
| WHERE (((TO_LOWER(process.executable) LIKE "*\\\\powershell.exe" OR TO_LOWER(process.executable) LIKE "*\\\\pwsh.exe") AND (TO_LOWER(process.command_line) LIKE "*-bxor*" OR TO_LOWER(process.command_line) LIKE "*-bnot*" OR TO_LOWER(process.command_line) LIKE "*-band*" OR TO_LOWER(process.command_line) LIKE "*-shl*" OR TO_LOWER(process.command_line) LIKE "*-shr*")) AND (TO_LOWER(process.command_line) LIKE "*readallbytes*" OR TO_LOWER(process.command_line) LIKE "*writeallbytes*" OR TO_LOWER(process.command_line) LIKE "*filestream*" OR TO_LOWER(process.command_line) LIKE "*openread*" OR TO_LOWER(process.command_line) LIKE "*openwrite*" OR TO_LOWER(process.command_line) LIKE "*get-content*" OR TO_LOWER(process.command_line) LIKE "*set-content*" OR TO_LOWER(process.command_line) LIKE "*-asbytestream*" OR TO_LOWER(process.command_line) LIKE "*-encoding byte*"))
