<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)^4104$</field>
    <field name="ScriptBlockText" type="pcre2">(?i)Set-ADUser</field>
    <field name="ScriptBlockText" type="pcre2">(?i)AllowReversiblePasswordEncryption</field>
    <field name="ScriptBlockText" type="pcre2">(?i)\$true</field>
    <description>PowerShell enables reversible encryption for an AD account</description>
    <mitre>
      <id>T1556.005</id>
    </mitre>
  </rule>
</group>
