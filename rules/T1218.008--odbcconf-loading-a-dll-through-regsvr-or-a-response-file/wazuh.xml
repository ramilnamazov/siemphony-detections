<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)\\odbcconf\.exe$</field>
    <field name="CommandLine" type="pcre2">(?i)(REGSVR|(-f |/f |–f |—f |―f ))</field>
    <description>Odbcconf loading a DLL through REGSVR or a response file</description>
    <mitre>
      <id>T1218.008</id>
    </mitre>
  </rule>
</group>
