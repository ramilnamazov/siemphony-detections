<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)\\shutdown\.exe$</field>
    <field name="CommandLine" type="pcre2">(?i)(-r|/r|–r|—r|―r|-s|/s|–s|—s|―s)</field>
    <field name="CommandLine" type="pcre2">(?i)(-f|/f|–f|—f|―f|-t 0|/t 0|–t 0|—t 0|―t 0)</field>
    <description>Forced shutdown or restart requested with no delay</description>
    <mitre>
      <id>T1529</id>
    </mitre>
  </rule>
</group>
