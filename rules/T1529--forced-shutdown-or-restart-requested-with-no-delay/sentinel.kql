DeviceProcessEvents
| where ((FolderPath endswith "\\shutdown.exe" and (ProcessCommandLine contains "-r" or ProcessCommandLine contains "/r" or ProcessCommandLine contains "–r" or ProcessCommandLine contains "—r" or ProcessCommandLine contains "―r" or ProcessCommandLine contains "-s" or ProcessCommandLine contains "/s" or ProcessCommandLine contains "–s" or ProcessCommandLine contains "—s" or ProcessCommandLine contains "―s")) and (ProcessCommandLine contains "-f" or ProcessCommandLine contains "/f" or ProcessCommandLine contains "–f" or ProcessCommandLine contains "—f" or ProcessCommandLine contains "―f" or ProcessCommandLine contains "-t 0" or ProcessCommandLine contains "/t 0" or ProcessCommandLine contains "–t 0" or ProcessCommandLine contains "—t 0" or ProcessCommandLine contains "―t 0"))
