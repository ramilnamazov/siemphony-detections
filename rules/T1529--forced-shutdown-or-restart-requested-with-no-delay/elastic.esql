FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*\\\\shutdown.exe" AND (TO_LOWER(process.command_line) LIKE "*-r*" OR TO_LOWER(process.command_line) LIKE "*/r*" OR TO_LOWER(process.command_line) LIKE "*–r*" OR TO_LOWER(process.command_line) LIKE "*—r*" OR TO_LOWER(process.command_line) LIKE "*―r*" OR TO_LOWER(process.command_line) LIKE "*-s*" OR TO_LOWER(process.command_line) LIKE "*/s*" OR TO_LOWER(process.command_line) LIKE "*–s*" OR TO_LOWER(process.command_line) LIKE "*—s*" OR TO_LOWER(process.command_line) LIKE "*―s*")) AND (TO_LOWER(process.command_line) LIKE "*-f*" OR TO_LOWER(process.command_line) LIKE "*/f*" OR TO_LOWER(process.command_line) LIKE "*–f*" OR TO_LOWER(process.command_line) LIKE "*—f*" OR TO_LOWER(process.command_line) LIKE "*―f*" OR TO_LOWER(process.command_line) LIKE "*-t 0*" OR TO_LOWER(process.command_line) LIKE "*/t 0*" OR TO_LOWER(process.command_line) LIKE "*–t 0*" OR TO_LOWER(process.command_line) LIKE "*—t 0*" OR TO_LOWER(process.command_line) LIKE "*―t 0*"))
