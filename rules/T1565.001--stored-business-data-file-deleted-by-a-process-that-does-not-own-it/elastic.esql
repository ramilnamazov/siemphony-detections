FROM logs-*
| WHERE ((TO_LOWER(file.path) LIKE "*.mdf" OR TO_LOWER(file.path) LIKE "*.ldf" OR TO_LOWER(file.path) LIKE "*.ndf" OR TO_LOWER(file.path) LIKE "*.mdb" OR TO_LOWER(file.path) LIKE "*.accdb" OR TO_LOWER(file.path) LIKE "*.pst" OR TO_LOWER(file.path) LIKE "*.ost") AND NOT ((TO_LOWER(process.executable) LIKE "*\\\\sqlservr.exe" OR TO_LOWER(process.executable) LIKE "*\\\\sqlagent.exe" OR TO_LOWER(process.executable) LIKE "*\\\\sqlwriter.exe" OR TO_LOWER(process.executable) LIKE "*\\\\mysqld.exe" OR TO_LOWER(process.executable) LIKE "*\\\\postgres.exe" OR TO_LOWER(process.executable) LIKE "*\\\\outlook.exe" OR TO_LOWER(process.executable) LIKE "*\\\\msaccess.exe")))
