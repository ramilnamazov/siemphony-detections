FROM logs-*
| WHERE (((TO_LOWER(winlog.event_data.TargetImage) LIKE "*\\\\keepass.exe" OR TO_LOWER(winlog.event_data.TargetImage) LIKE "*\\\\keepassxc.exe" OR TO_LOWER(winlog.event_data.TargetImage) LIKE "*\\\\1password.exe" OR TO_LOWER(winlog.event_data.TargetImage) LIKE "*\\\\1password7.exe" OR TO_LOWER(winlog.event_data.TargetImage) LIKE "*\\\\bitwarden.exe") AND (TO_LOWER(winlog.event_data.GrantedAccess) LIKE "*0x1010*" OR TO_LOWER(winlog.event_data.GrantedAccess) LIKE "*0x1038*" OR TO_LOWER(winlog.event_data.GrantedAccess) LIKE "*0x1400*" OR TO_LOWER(winlog.event_data.GrantedAccess) LIKE "*0x1410*" OR TO_LOWER(winlog.event_data.GrantedAccess) LIKE "*0x1438*" OR TO_LOWER(winlog.event_data.GrantedAccess) LIKE "*0x143a*" OR TO_LOWER(winlog.event_data.GrantedAccess) LIKE "*0x1fffff*")) AND NOT ((TO_LOWER(process.executable) LIKE "*\\\\msmpeng.exe" OR TO_LOWER(process.executable) LIKE "*\\\\werfault.exe")))
