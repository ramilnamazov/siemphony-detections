FROM logs-*
| WHERE (TO_LOWER(winlog.provider_name) == "service control manager" AND (event.code == 7031 OR event.code == 7034) AND (TO_LOWER(winlog.event_data.param1) LIKE "*world wide web publishing*" OR TO_LOWER(winlog.event_data.param1) LIKE "*iis admin*" OR TO_LOWER(winlog.event_data.param1) LIKE "*sql server*" OR TO_LOWER(winlog.event_data.param1) LIKE "*mysql*" OR TO_LOWER(winlog.event_data.param1) LIKE "*postgresql*" OR TO_LOWER(winlog.event_data.param1) LIKE "*apache*" OR TO_LOWER(winlog.event_data.param1) LIKE "*routing and remote access*" OR TO_LOWER(winlog.event_data.param1) LIKE "*remote desktop services*"))
