FROM logs-*
| WHERE (event.code == 4625 AND (LogonType == 3 OR LogonType == 8 OR LogonType == 10) AND (TO_LOWER(SubStatus) == "0xc000006a" OR TO_LOWER(SubStatus) == "0xc0000064") AND (TO_LOWER(TargetUserName) == "administrator" OR TO_LOWER(TargetUserName) == "admin" OR TO_LOWER(TargetUserName) == "guest" OR TO_LOWER(TargetUserName) == "root" OR TO_LOWER(TargetUserName) == "sa" OR TO_LOWER(TargetUserName) == "sysadmin" OR TO_LOWER(TargetUserName) == "oracle" OR TO_LOWER(TargetUserName) == "postgres" OR TO_LOWER(TargetUserName) == "ftp" OR TO_LOWER(TargetUserName) == "test" OR TO_LOWER(TargetUserName) == "user" OR TO_LOWER(TargetUserName) == "backup" OR TO_LOWER(TargetUserName) == "support" OR TO_LOWER(TargetUserName) == "demo"))
