<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <!-- 2 rules: the Sigma condition ORs across different fields,
       which one rule cannot express. Any one matching is a hit. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\bcdedit\.exe$|\\bootcfg\.exe$)</field>
    <field name="CommandLine" type="pcre2">(?i)safeboot</field>
    <description>Safe mode boot armed from a command line (1/2)</description>
    <mitre>
      <id>T1688</id>
    </mitre>
  </rule>

  <rule id="100001" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)CurrentControlSet\\Control\\SafeBoot</field>
    <description>Safe mode boot armed from a command line (2/2)</description>
    <mitre>
      <id>T1688</id>
    </mitre>
  </rule>
</group>
