<group name="sigma,windows,network_connection,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\rundll32\.exe$|\\mshta\.exe$|\\wscript\.exe$|\\cscript\.exe$|\\regsvr32\.exe$|\\certutil\.exe$)</field>
    <field name="Initiated" type="pcre2">(?i)^true$</field>
    <field name="DestinationPort" type="pcre2">(?i)(^1080$|^3128$|^4444$|^8080$|^8081$|^8888$|^9001$|^9050$|^9051$|^9150$)</field>
    <field name="DestinationIp" negate="yes" type="pcre2">(?i)(^10\.|^127\.|^169\.254\.|^172\.16\.|^172\.17\.|^172\.18\.|^172\.19\.|^172\.20\.|^172\.21\.|^172\.22\.|^172\.23\.|^172\.24\.|^172\.25\.|^172\.26\.|^172\.27\.|^172\.28\.|^172\.29\.|^172\.30\.|^172\.31\.|^192\.168\.|^fd|^fe80:|^::1)</field>
    <description>Script host or LOLBin connecting outbound to a proxy port</description>
    <mitre>
      <id>T1090.002</id>
    </mitre>
  </rule>
</group>
