<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\wscript\.exe$|\\cscript\.exe$|\\cmd\.exe$)</field>
    <field name="CommandLine" type="pcre2">(?i)SyncAppvPublishingServer\.vbs</field>
    <field name="CommandLine" type="pcre2">(?i)(;|powershell|pwsh|-enc|IEX|Invoke-Expression|Net\.WebClient|DownloadString|DownloadFile|FromBase64String)</field>
    <description>Script proxy runs PowerShell through SyncAppvPublishingServer</description>
    <mitre>
      <id>T1216.002</id>
    </mitre>
  </rule>
</group>
