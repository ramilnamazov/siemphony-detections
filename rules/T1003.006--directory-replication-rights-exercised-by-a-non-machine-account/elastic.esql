FROM logs-*
| WHERE ((event.code == 4662 AND TO_LOWER(winlog.event_data.AccessMask) == "0x100" AND (TO_LOWER(winlog.event_data.Properties) LIKE "*1131f6aa-9c07-11d1-f79f-00c04fc2dcd2*" OR TO_LOWER(winlog.event_data.Properties) LIKE "*1131f6ad-9c07-11d1-f79f-00c04fc2dcd2*" OR TO_LOWER(winlog.event_data.Properties) LIKE "*89e95b76-444d-4c62-991a-0facbeda640c*")) AND NOT (TO_LOWER(user.name) LIKE "*$"))
