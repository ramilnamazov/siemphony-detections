<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\control\.exe$|\\rundll32\.exe$)</field>
    <field name="CommandLine" type="pcre2">(?i)\.cpl</field>
    <field name="CommandLine" type="pcre2">(?i)(\\AppData\\|\\Temp\\|\\Users\\Public\\|\\Downloads\\|\\ProgramData\\|\\Windows\\Tasks\\|\\PerfLogs\\)</field>
    <description>Control panel item executed from a user-writable directory</description>
    <mitre>
      <id>T1218.002</id>
    </mitre>
  </rule>
</group>
