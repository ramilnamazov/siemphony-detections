FROM logs-*
| WHERE (TO_LOWER(process.command_line) LIKE "*stratum+tcp://*" OR TO_LOWER(process.command_line) LIKE "*stratum+ssl://*" OR TO_LOWER(process.command_line) LIKE "*stratum1+tcp://*" OR TO_LOWER(process.command_line) LIKE "*stratum2+tcp://*" OR TO_LOWER(process.command_line) LIKE "*--donate-level*" OR TO_LOWER(process.command_line) LIKE "*--nicehash*" OR TO_LOWER(process.command_line) LIKE "*--rig-id*" OR TO_LOWER(process.command_line) LIKE "*--algo=rx/0*" OR TO_LOWER(process.command_line) LIKE "*--algo=randomx*" OR TO_LOWER(process.command_line) LIKE "*--coin=monero*" OR TO_LOWER(process.command_line) LIKE "*xmrig*" OR TO_LOWER(process.command_line) LIKE "*minerd*")
