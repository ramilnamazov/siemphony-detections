<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)\\nltest\.exe$</field>
    <field name="CommandLine" type="pcre2">(?i)(/domain_trusts|/trusted_domains|/all_trusts)</field>
    <description>Nltest execution enumerating domain trust relationships</description>
    <mitre>
      <id>T1482</id>
    </mitre>
  </rule>
</group>
