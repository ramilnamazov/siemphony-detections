<group name="sigma,linux,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(/nc$|/nc\.openbsd$|/nc\.traditional$|/ncat$|/socat$|/telnet$)</field>
    <field name="CommandLine" type="pcre2">(?i)(6667|6668|6669|6697)</field>
    <description>Raw socket tool invoked against a classic IRC port</description>
    <mitre>
      <id>T1071</id>
    </mitre>
  </rule>
</group>
