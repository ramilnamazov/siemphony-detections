<group name="sigma,windows,registry_set,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="TargetObject" type="pcre2">(?i)\\SpecialAccounts\\UserList\\</field>
    <field name="Details" type="pcre2">(?i)^DWORD \(0x00000000\)$</field>
    <description>User account marked hidden in the Windows SpecialAccounts UserList</description>
    <mitre>
      <id>T1564.002</id>
    </mitre>
  </rule>
</group>
