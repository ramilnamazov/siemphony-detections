<group name="sigma,windows,registry_set,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="TargetObject" type="pcre2">(?i)(\\Cryptography\\OID\\EncodingType 0\\CryptSIPDllGetSignedDataMsg\\|\\Cryptography\\OID\\EncodingType 0\\CryptSIPDllVerifyIndirectData\\)</field>
    <description>Registry write to a Subject Interface Package signing function entry</description>
    <mitre>
      <id>T1553.003</id>
    </mitre>
  </rule>
</group>
