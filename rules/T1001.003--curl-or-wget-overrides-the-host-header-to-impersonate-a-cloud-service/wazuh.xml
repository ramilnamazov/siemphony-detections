<group name="sigma,linux,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(/curl$|/wget$)</field>
    <field name="CommandLine" type="pcre2">(?i)(Host: mail\.google\.com|Host: docs\.google\.com|Host: www\.dropbox\.com|Host: login\.live\.com)</field>
    <description>curl or wget overrides the Host header to impersonate a cloud service</description>
    <mitre>
      <id>T1001.003</id>
    </mitre>
  </rule>
</group>
