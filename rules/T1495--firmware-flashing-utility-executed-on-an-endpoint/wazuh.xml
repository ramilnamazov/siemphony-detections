<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\flashrom\.exe$|\\afuwin\.exe$|\\afuwinx64\.exe$|\\afuwingui\.exe$|\\fpt\.exe$|\\fptw\.exe$|\\fptw64\.exe$|\\flash64w\.exe$|\\winflash\.exe$|\\winflash64\.exe$|\\nvflash\.exe$|\\nvflash64\.exe$|\\amdvbflash\.exe$|\\atiflash\.exe$)</field>
    <description>Firmware flashing utility executed on an endpoint</description>
    <mitre>
      <id>T1495</id>
    </mitre>
  </rule>
</group>
