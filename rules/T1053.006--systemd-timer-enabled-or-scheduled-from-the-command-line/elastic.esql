FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*/systemctl" AND TO_LOWER(process.command_line) LIKE "*.timer*") OR (TO_LOWER(process.executable) LIKE "*/systemd-run" AND (TO_LOWER(process.command_line) LIKE "*--on-active*" OR TO_LOWER(process.command_line) LIKE "*--on-boot*" OR TO_LOWER(process.command_line) LIKE "*--on-startup*" OR TO_LOWER(process.command_line) LIKE "*--on-unit-active*" OR TO_LOWER(process.command_line) LIKE "*--on-unit-inactive*" OR TO_LOWER(process.command_line) LIKE "*--on-calendar*" OR TO_LOWER(process.command_line) LIKE "*--timer-property*")))
