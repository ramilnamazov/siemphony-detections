FROM logs-*
| WHERE (event.code == 4697 AND (TO_LOWER(winlog.event_data.ServiceFileName) LIKE "*\\\\cmd.exe*" OR TO_LOWER(winlog.event_data.ServiceFileName) LIKE "*%comspec%*" OR TO_LOWER(winlog.event_data.ServiceFileName) LIKE "*powershell*" OR TO_LOWER(winlog.event_data.ServiceFileName) LIKE "*\\\\pwsh.exe*" OR TO_LOWER(winlog.event_data.ServiceFileName) LIKE "*\\\\wscript.exe*" OR TO_LOWER(winlog.event_data.ServiceFileName) LIKE "*\\\\cscript.exe*" OR TO_LOWER(winlog.event_data.ServiceFileName) LIKE "*\\\\mshta.exe*" OR TO_LOWER(winlog.event_data.ServiceFileName) LIKE "*\\\\rundll32.exe*" OR TO_LOWER(winlog.event_data.ServiceFileName) LIKE "*\\\\regsvr32.exe*" OR TO_LOWER(winlog.event_data.ServiceFileName) LIKE "*psexesvc*" OR TO_LOWER(winlog.event_data.ServiceFileName) LIKE "*\\\\\\\\*"))
