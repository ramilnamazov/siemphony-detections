<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)^4697$</field>
    <field name="ServiceFileName" type="pcre2">(?i)(\\cmd\.exe|%COMSPEC%|powershell|\\pwsh\.exe|\\wscript\.exe|\\cscript\.exe|\\mshta\.exe|\\rundll32\.exe|\\regsvr32\.exe|PSEXESVC|\\\\)</field>
    <description>Service installed with a shell, script host or UNC image path</description>
    <mitre>
      <id>T1569.002</id>
    </mitre>
  </rule>
</group>
