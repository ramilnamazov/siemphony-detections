<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)^5136$</field>
    <field name="ObjectClass" type="pcre2">(?i)^groupPolicyContainer$</field>
    <field name="AttributeLDAPDisplayName" type="pcre2">(?i)(^gPCFileSysPath$|^gPCMachineExtensionNames$|^gPCUserExtensionNames$|^nTSecurityDescriptor$)</field>
    <description>Group Policy object rewritten in its code path or its permissions</description>
    <mitre>
      <id>T1484.001</id>
    </mitre>
  </rule>
</group>
