FROM logs-*
| WHERE ((event.code == 5136 AND TO_LOWER(ObjectClass) == "grouppolicycontainer") AND (TO_LOWER(AttributeLDAPDisplayName) == "gpcfilesyspath" OR TO_LOWER(AttributeLDAPDisplayName) == "gpcmachineextensionnames" OR TO_LOWER(AttributeLDAPDisplayName) == "gpcuserextensionnames" OR TO_LOWER(AttributeLDAPDisplayName) == "ntsecuritydescriptor"))
