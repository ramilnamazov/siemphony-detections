FROM logs-*
| WHERE ((event.code == 5136 AND TO_LOWER(winlog.event_data.ObjectClass) == "grouppolicycontainer") AND (TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "gpcfilesyspath" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "gpcmachineextensionnames" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "gpcuserextensionnames" OR TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "ntsecuritydescriptor"))
