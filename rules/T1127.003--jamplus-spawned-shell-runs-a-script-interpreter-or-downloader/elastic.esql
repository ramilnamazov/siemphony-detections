FROM logs-*
| WHERE ((((TO_LOWER(process.parent.executable) LIKE "*\\\\jam.exe" OR TO_LOWER(process.parent.executable) LIKE "*\\\\jamplus.exe") OR TO_LOWER(process.parent.command_line) LIKE "*.jam*") AND TO_LOWER(process.executable) LIKE "*\\\\cmd.exe") AND (TO_LOWER(process.command_line) LIKE "*powershell*" OR TO_LOWER(process.command_line) LIKE "*pwsh*" OR TO_LOWER(process.command_line) LIKE "*wscript*" OR TO_LOWER(process.command_line) LIKE "*cscript*" OR TO_LOWER(process.command_line) LIKE "*mshta*" OR TO_LOWER(process.command_line) LIKE "*rundll32*" OR TO_LOWER(process.command_line) LIKE "*regsvr32*" OR TO_LOWER(process.command_line) LIKE "*certutil*" OR TO_LOWER(process.command_line) LIKE "*curl*" OR TO_LOWER(process.command_line) LIKE "*bitsadmin*"))
