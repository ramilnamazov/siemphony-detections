<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)(--gpu-launcher=|--renderer-cmd-prefix=|--utility-cmd-prefix=|--browser-subprocess-path=)</field>
    <description>Electron launcher switch used to run an arbitrary child process</description>
    <mitre>
      <id>T1218.015</id>
    </mitre>
  </rule>
</group>
