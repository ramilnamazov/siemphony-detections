<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)^4104$</field>
    <field name="ScriptBlockText" type="pcre2">(?i)(env:COMPUTERNAME|env:USERDOMAIN|env:USERDNSDOMAIN|env:LOGONSERVER|Win32_ComputerSystemProduct|Win32_BIOS|Win32_NetworkAdapterConfiguration|MachineGuid|GetHostByName|Get-ADDomain)</field>
    <field name="ScriptBlockText" type="pcre2">(?i)(System\.Security\.Cryptography|AesManaged|AesCryptoServiceProvider|RijndaelManaged|CreateDecryptor|DeriveBytes|ComputeHash|ConvertTo-SecureString)</field>
    <description>Script derives a cryptographic key from a machine identifier</description>
    <mitre>
      <id>T1480.001</id>
    </mitre>
  </rule>
</group>
