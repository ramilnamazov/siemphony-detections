<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\wscript\.exe$|\\cscript\.exe$)</field>
    <field name="CommandLine" type="pcre2">(?i)(\.js|\.jse)</field>
    <description>Windows Script Host launching a JScript or JSE file</description>
    <mitre>
      <id>T1059.007</id>
    </mitre>
  </rule>
</group>
