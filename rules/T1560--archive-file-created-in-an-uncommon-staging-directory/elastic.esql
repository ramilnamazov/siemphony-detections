FROM logs-*
| WHERE ((TO_LOWER(file.path) LIKE "*.7z" OR TO_LOWER(file.path) LIKE "*.rar" OR TO_LOWER(file.path) LIKE "*.zip" OR TO_LOWER(file.path) LIKE "*.tar" OR TO_LOWER(file.path) LIKE "*.gz" OR TO_LOWER(file.path) LIKE "*.tgz" OR TO_LOWER(file.path) LIKE "*.bz2" OR TO_LOWER(file.path) LIKE "*.cab" OR TO_LOWER(file.path) LIKE "*.arj") AND (TO_LOWER(file.path) LIKE "*\\\\users\\\\public\\\\*" OR TO_LOWER(file.path) LIKE "*\\\\perflogs\\\\*" OR TO_LOWER(file.path) LIKE "*\\\\windows\\\\temp\\\\*" OR TO_LOWER(file.path) LIKE "*\\\\windows\\\\tasks\\\\*" OR TO_LOWER(file.path) LIKE "*\\\\windows\\\\debug\\\\*" OR TO_LOWER(file.path) LIKE "*\\\\windows\\\\addins\\\\*" OR TO_LOWER(file.path) LIKE "*\\\\$recycle.bin\\\\*"))
