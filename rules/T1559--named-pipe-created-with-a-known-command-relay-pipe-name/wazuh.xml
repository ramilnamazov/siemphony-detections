<group name="sigma,windows,pipe_created,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="PipeName" type="pcre2">(?i)((^\\postex_|^\\status_|^\\PSEXESVC)|(^\\msagent_|^\\MSSE-))</field>
    <description>Named pipe created with a known command-relay pipe name</description>
    <mitre>
      <id>T1559</id>
    </mitre>
  </rule>
</group>
