DeviceProcessEvents
| where (((InitiatingProcessFolderPath endswith "/sshd" or InitiatingProcessFolderPath endswith "/sshd-session") and (FolderPath endswith "/bash" or FolderPath endswith "/sh" or FolderPath endswith "/dash" or FolderPath endswith "/zsh")) and (ProcessCommandLine contains "base64 -d" or ProcessCommandLine contains "base64 --decode" or ProcessCommandLine contains "/dev/tcp/" or ProcessCommandLine contains "nc -e" or ProcessCommandLine contains "ncat -e" or ProcessCommandLine contains "socat exec" or ProcessCommandLine contains "mkfifo" or ProcessCommandLine contains "0>&1"))
