<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)^4104$</field>
    <field name="ScriptBlockText" type="pcre2">(?i)(New-InboxRule|Set-InboxRule)</field>
    <field name="ScriptBlockText" type="pcre2">(?i)(-DeleteMessage|-SoftDeleteMessage|-MoveToFolder|-StopProcessingRules|-MarkAsRead)</field>
    <description>PowerShell inbox rule created or modified to delete, move or hide mail</description>
    <mitre>
      <id>T1564.008</id>
    </mitre>
  </rule>
</group>
