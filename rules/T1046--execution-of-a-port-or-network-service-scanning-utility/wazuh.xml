<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\nmap\.exe$|\\ncat\.exe$|\\masscan\.exe$|\\rustscan\.exe$|\\naabu\.exe$|\\fscan\.exe$|\\netscan\.exe$|\\nbtscan\.exe$|\\advanced_ip_scanner\.exe$|\\advanced_port_scanner\.exe$|\\portqry\.exe$)</field>
    <description>Execution of a port or network service scanning utility</description>
    <mitre>
      <id>T1046</id>
    </mitre>
  </rule>
</group>
