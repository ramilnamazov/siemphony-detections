<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)(CopyFromScreen|CopyPixelOperation|System\.Drawing\.Bitmap|Drawing\.Graphics\]::FromImage|BitBlt|PrintWindow|savescreenshot|psr\.exe /start|Get-Screenshot)</field>
    <description>Screen capture invoked from the command line</description>
    <mitre>
      <id>T1113</id>
    </mitre>
  </rule>
</group>
