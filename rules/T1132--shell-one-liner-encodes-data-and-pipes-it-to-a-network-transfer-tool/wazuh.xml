<group name="sigma,linux,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(/bash$|/sh$|/dash$)</field>
    <field name="CommandLine" type="pcre2">(?i)(base64|gzip|xxd|uuencode|b64encode)</field>
    <field name="CommandLine" type="pcre2">(?i)(curl|wget|netcat| nc )</field>
    <description>Shell one-liner encodes data and pipes it to a network transfer tool</description>
    <mitre>
      <id>T1132</id>
    </mitre>
  </rule>
</group>
