FROM logs-*
| WHERE (((TO_LOWER(process.executable) LIKE "*/bash" OR TO_LOWER(process.executable) LIKE "*/sh" OR TO_LOWER(process.executable) LIKE "*/dash") AND (TO_LOWER(process.command_line) LIKE "*base64*" OR TO_LOWER(process.command_line) LIKE "*gzip*" OR TO_LOWER(process.command_line) LIKE "*xxd*" OR TO_LOWER(process.command_line) LIKE "*uuencode*" OR TO_LOWER(process.command_line) LIKE "*b64encode*")) AND (TO_LOWER(process.command_line) LIKE "*curl*" OR TO_LOWER(process.command_line) LIKE "*wget*" OR TO_LOWER(process.command_line) LIKE "*netcat*" OR TO_LOWER(process.command_line) LIKE "* nc *"))
