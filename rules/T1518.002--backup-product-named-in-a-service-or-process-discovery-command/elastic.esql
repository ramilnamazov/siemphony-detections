FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*\\\\tasklist.exe" OR TO_LOWER(process.executable) LIKE "*\\\\sc.exe" OR TO_LOWER(process.executable) LIKE "*\\\\reg.exe" OR TO_LOWER(process.executable) LIKE "*\\\\wmic.exe" OR TO_LOWER(process.executable) LIKE "*\\\\net.exe" OR TO_LOWER(process.executable) LIKE "*\\\\findstr.exe" OR TO_LOWER(process.executable) LIKE "*\\\\cmd.exe" OR TO_LOWER(process.executable) LIKE "*\\\\powershell.exe" OR TO_LOWER(process.executable) LIKE "*\\\\pwsh.exe") AND (TO_LOWER(process.command_line) LIKE "*veeam*" OR TO_LOWER(process.command_line) LIKE "*acronis*" OR TO_LOWER(process.command_line) LIKE "*crashplan*" OR TO_LOWER(process.command_line) LIKE "*backupexec*" OR TO_LOWER(process.command_line) LIKE "*netbackup*" OR TO_LOWER(process.command_line) LIKE "*commvault*" OR TO_LOWER(process.command_line) LIKE "*arcserve*" OR TO_LOWER(process.command_line) LIKE "*macrium*" OR TO_LOWER(process.command_line) LIKE "*shadowprotect*" OR TO_LOWER(process.command_line) LIKE "*rubrik*" OR TO_LOWER(process.command_line) LIKE "*cohesity*" OR TO_LOWER(process.command_line) LIKE "*datto*"))
