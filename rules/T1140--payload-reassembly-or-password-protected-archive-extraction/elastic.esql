FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*\\\\cmd.exe" AND TO_LOWER(process.command_line) LIKE "*copy /b*") OR (TO_LOWER(process.executable) LIKE "*\\\\expand.exe" AND (TO_LOWER(process.command_line) LIKE "*-f:*" OR TO_LOWER(process.command_line) LIKE "*/f:*" OR TO_LOWER(process.command_line) LIKE "*–f:*" OR TO_LOWER(process.command_line) LIKE "*—f:*" OR TO_LOWER(process.command_line) LIKE "*―f:*")) OR ((TO_LOWER(process.executable) LIKE "*\\\\7z.exe" OR TO_LOWER(process.executable) LIKE "*\\\\7za.exe" OR TO_LOWER(process.executable) LIKE "*\\\\rar.exe" OR TO_LOWER(process.executable) LIKE "*\\\\unrar.exe" OR TO_LOWER(process.executable) LIKE "*\\\\winrar.exe") AND TO_LOWER(process.command_line) LIKE "* -p*"))
