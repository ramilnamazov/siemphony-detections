FROM logs-*
| WHERE (TO_LOWER(process.command_line) LIKE "*net view*" OR TO_LOWER(process.command_line) LIKE "*net.exe view*" OR TO_LOWER(process.command_line) LIKE "*net1 view*" OR TO_LOWER(process.command_line) LIKE "*net1.exe view*" OR TO_LOWER(process.command_line) LIKE "*net share*" OR TO_LOWER(process.command_line) LIKE "*net.exe share*" OR TO_LOWER(process.command_line) LIKE "*net1 share*" OR TO_LOWER(process.command_line) LIKE "*net1.exe share*" OR TO_LOWER(process.command_line) LIKE "*get-smbshare*" OR TO_LOWER(process.command_line) LIKE "*win32_share*" OR TO_LOWER(process.command_line) LIKE "*netshareenum*")
