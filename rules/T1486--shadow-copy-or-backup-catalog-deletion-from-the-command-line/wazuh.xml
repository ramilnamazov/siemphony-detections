<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)((?=.*(?:vssadmin))(?=.*(?:delete shadows)).*|(?=.*(?:vssadmin))(?=.*(?:resize shadowstorage)).*|(?=.*(?:shadowcopy))(?=.*(?:delete)).*|(?=.*(?:wbadmin))(?=.*(?:delete)).*|(?=.*(?:bcdedit))(?=.*(?:recoveryenabled)).*|(?=.*(?:bcdedit))(?=.*(?:ignoreallfailures)).*)</field>
    <description>Shadow copy or backup catalog deletion from the command line</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>
</group>
