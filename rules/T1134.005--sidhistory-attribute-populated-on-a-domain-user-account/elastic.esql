FROM logs-*
| WHERE ((event.code == 5136 AND TO_LOWER(winlog.event_data.ObjectClass) == "user" AND TO_LOWER(winlog.event_data.AttributeLDAPDisplayName) == "sidhistory") OR (event.code == 4720 AND TO_LOWER(winlog.event_data.SidHistory) LIKE "*s-1-5-21-*") OR (event.code == 4738 AND TO_LOWER(winlog.event_data.SidHistory) LIKE "*s-1-5-21-*"))
