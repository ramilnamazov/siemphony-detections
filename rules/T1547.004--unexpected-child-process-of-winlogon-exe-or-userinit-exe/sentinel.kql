DeviceProcessEvents
| where ((InitiatingProcessFolderPath endswith "\\winlogon.exe" or InitiatingProcessFolderPath endswith "\\userinit.exe") and not (((FolderPath endswith "\\Windows\\System32\\userinit.exe" or FolderPath endswith "\\Windows\\explorer.exe" or FolderPath endswith "\\Windows\\System32\\LogonUI.exe" or FolderPath endswith "\\Windows\\System32\\dwm.exe" or FolderPath endswith "\\Windows\\System32\\fontdrvhost.exe" or FolderPath endswith "\\Windows\\System32\\wlrmdr.exe" or FolderPath endswith "\\Windows\\System32\\mpnotify.exe" or FolderPath endswith "\\Windows\\System32\\rdpclip.exe" or FolderPath endswith "\\Windows\\System32\\AtBroker.exe") or (InitiatingProcessFolderPath endswith "\\userinit.exe" and (FolderPath endswith "\\cmd.exe" or FolderPath endswith "\\cscript.exe" or FolderPath endswith "\\wscript.exe" or FolderPath endswith "\\powershell.exe") and (ProcessCommandLine contains "\\NETLOGON\\" or ProcessCommandLine contains "\\SYSVOL\\")))))
