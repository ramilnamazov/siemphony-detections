index=* ((ParentImage="*\\winlogon.exe" OR ParentImage="*\\userinit.exe") AND NOT (((Image="*\\Windows\\System32\\userinit.exe" OR Image="*\\Windows\\explorer.exe" OR Image="*\\Windows\\System32\\LogonUI.exe" OR Image="*\\Windows\\System32\\dwm.exe" OR Image="*\\Windows\\System32\\fontdrvhost.exe" OR Image="*\\Windows\\System32\\wlrmdr.exe" OR Image="*\\Windows\\System32\\mpnotify.exe" OR Image="*\\Windows\\System32\\rdpclip.exe" OR Image="*\\Windows\\System32\\AtBroker.exe") OR (ParentImage="*\\userinit.exe" AND (Image="*\\cmd.exe" OR Image="*\\cscript.exe" OR Image="*\\wscript.exe" OR Image="*\\powershell.exe") AND (CommandLine="*\\NETLOGON\\*" OR CommandLine="*\\SYSVOL\\*")))))
