<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)\\rundll32\.exe$</field>
    <field name="CommandLine" type="pcre2">(?i)javascript:</field>
    <field name="CommandLine" type="pcre2">(?i)RunHTMLApplication</field>
    <description>Rundll32 proxies JavaScript through mshtml's HTML application runner</description>
    <mitre>
      <id>T1218.011</id>
    </mitre>
  </rule>
</group>
