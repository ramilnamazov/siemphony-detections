<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)^4104$</field>
    <field name="ScriptBlockText" type="pcre2">(?i)(New-InboxRule|Set-InboxRule|New-TransportRule|Set-TransportRule|Set-Mailbox)</field>
    <field name="ScriptBlockText" type="pcre2">(?i)(ForwardTo|ForwardAsAttachmentTo|RedirectTo|RedirectMessageTo|ForwardingSmtpAddress|ForwardingAddress|DeliverToMailboxAndForward|BlindCopyTo)</field>
    <description>Mail forwarding rule created in a script block</description>
    <mitre>
      <id>T1114.003</id>
    </mitre>
  </rule>
</group>
