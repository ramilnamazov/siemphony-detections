FROM logs-*
| WHERE ((TO_LOWER(winlog.event_data.GrantedAccess) == "0x1f0fff" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x1f1fff" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x1f2fff" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x1f3fff" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x1fffff" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x147a" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x143a" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x47a" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x43a" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x42a" OR TO_LOWER(winlog.event_data.GrantedAccess) == "0x2a") AND TO_LOWER(winlog.event_data.CallTrace) LIKE "*unknown*")
