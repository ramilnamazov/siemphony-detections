FROM logs-*
| WHERE ((((((TO_LOWER(process.executable) LIKE "*\\\\net.exe" OR TO_LOWER(process.executable) LIKE "*\\\\net1.exe") AND TO_LOWER(process.command_line) LIKE "* user *") AND (TO_LOWER(process.command_line) LIKE "* /add*" OR TO_LOWER(process.command_line) LIKE "* -add*")) AND (TO_LOWER(process.command_line) LIKE "* /do*" OR TO_LOWER(process.command_line) LIKE "* -do*")) OR TO_LOWER(process.command_line) LIKE "*new-aduser*") OR (TO_LOWER(process.executable) LIKE "*\\\\dsadd.exe" AND TO_LOWER(process.command_line) LIKE "* user*"))
