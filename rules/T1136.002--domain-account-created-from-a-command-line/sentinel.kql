DeviceProcessEvents
| where ((((((FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe") and ProcessCommandLine contains " user ") and (ProcessCommandLine contains " /add" or ProcessCommandLine contains " -add")) and (ProcessCommandLine contains " /do" or ProcessCommandLine contains " -do")) or ProcessCommandLine contains "New-ADUser") or (FolderPath endswith "\\dsadd.exe" and ProcessCommandLine contains " user"))
