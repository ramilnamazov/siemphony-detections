<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="3">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)(^8001$|^8002$|^8003$)</field>
    <description>Wireless network association event recorded on a Windows host</description>
    <mitre>
      <id>T1669</id>
    </mitre>
  </rule>
</group>
