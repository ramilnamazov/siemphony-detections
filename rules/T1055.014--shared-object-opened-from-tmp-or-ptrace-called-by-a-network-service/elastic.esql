FROM logs-*
| WHERE ((TO_LOWER(type) == "path" AND (TO_LOWER(name) LIKE "*/tmp/*" OR TO_LOWER(name) LIKE "*/dev/shm/*" OR TO_LOWER(name) LIKE "*/var/tmp/*") AND TO_LOWER(name) LIKE "*.so") OR (TO_LOWER(type) == "syscall" AND TO_LOWER(syscall) == "ptrace" AND (TO_LOWER(exe) LIKE "*/nginx" OR TO_LOWER(exe) LIKE "*/apache2" OR TO_LOWER(exe) LIKE "*/sshd")))
