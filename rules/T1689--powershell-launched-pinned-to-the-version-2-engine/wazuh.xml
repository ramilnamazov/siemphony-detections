<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\powershell\.exe$|\\powershell_ise\.exe$)</field>
    <field name="CommandLine" type="pcre2">(?i)(-version 2|-versio 2|-versi 2|-vers 2|-ver 2|-ve 2)</field>
    <description>PowerShell launched pinned to the version 2 engine</description>
    <mitre>
      <id>T1689</id>
    </mitre>
  </rule>
</group>
