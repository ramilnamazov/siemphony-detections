FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*\\\\powershell.exe" OR TO_LOWER(process.executable) LIKE "*\\\\pwsh.exe") AND (TO_LOWER(process.command_line) LIKE "*-stream*" OR TO_LOWER(process.command_line) LIKE "*/stream*" OR TO_LOWER(process.command_line) LIKE "*–stream*" OR TO_LOWER(process.command_line) LIKE "*—stream*" OR TO_LOWER(process.command_line) LIKE "*―stream*"))
