DeviceProcessEvents
| where ((ProcessCommandLine contains "Win32_Product" or ProcessCommandLine contains "Win32_InstalledWin32Program" or ProcessCommandLine contains "Win32_InstalledStoreProgram" or ProcessCommandLine contains "Win32_SoftwareElement" or ProcessCommandLine contains "Win32_SoftwareFeature") or ProcessCommandLine contains "\\CurrentVersion\\Uninstall" or (ProcessCommandLine contains "Get-Package" or ProcessCommandLine contains "Get-AppxPackage" or ProcessCommandLine contains "Get-AppvClientPackage" or ProcessCommandLine contains "Get-WindowsCapability" or ProcessCommandLine contains "Get-InstalledModule") or (FolderPath endswith "\\wmic.exe" and ProcessCommandLine contains " product"))
