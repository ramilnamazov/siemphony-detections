FROM logs-*
| WHERE ((TO_LOWER(process.parent.executable) LIKE "*\\\\w3wp.exe" OR TO_LOWER(process.parent.executable) LIKE "*\\\\php-cgi.exe" OR TO_LOWER(process.parent.executable) LIKE "*\\\\httpd.exe" OR TO_LOWER(process.parent.executable) LIKE "*\\\\nginx.exe" OR TO_LOWER(process.parent.executable) LIKE "*\\\\sqlservr.exe") AND (TO_LOWER(process.executable) LIKE "*\\\\cmd.exe" OR TO_LOWER(process.executable) LIKE "*\\\\powershell.exe" OR TO_LOWER(process.executable) LIKE "*\\\\pwsh.exe" OR TO_LOWER(process.executable) LIKE "*\\\\cscript.exe" OR TO_LOWER(process.executable) LIKE "*\\\\wscript.exe" OR TO_LOWER(process.executable) LIKE "*\\\\mshta.exe" OR TO_LOWER(process.executable) LIKE "*\\\\bash.exe" OR TO_LOWER(process.executable) LIKE "*\\\\wsl.exe"))
