index=* | where (((match(Image, "(?i)\\\\powershell\\.exe$") OR match(Image, "(?i)\\\\pwsh\\.exe$")) AND (match(CommandLine, "(?i)-enc") OR match(CommandLine, "(?i)/enc") OR match(CommandLine, "(?i)–enc") OR match(CommandLine, "(?i)—enc") OR match(CommandLine, "(?i)―enc") OR match(CommandLine, "(?i)-EncodedCommand") OR match(CommandLine, "(?i)/EncodedCommand") OR match(CommandLine, "(?i)–EncodedCommand") OR match(CommandLine, "(?i)—EncodedCommand") OR match(CommandLine, "(?i)―EncodedCommand"))) OR match(CommandLine, "(\\^[A-Za-z]){5,}") OR match(CommandLine, "\"[^\"]{1,40}\"\\s*\\+\\s*\"[^\"]{1,40}\""))
