<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)^6416$</field>
    <field name="ClassName" type="pcre2">(?i)(^HIDClass$|^Net$|^DiskDrive$|^SCSIAdapter$)</field>
    <description>External device of a code-execution or network class attached</description>
    <mitre>
      <id>T1200</id>
    </mitre>
  </rule>
</group>
