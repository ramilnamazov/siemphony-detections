<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)\\appcmd\.exe$</field>
    <field name="CommandLine" type="pcre2">(?i)(isapiFilters|globalModules|system\.webServer/modules|add module)</field>
    <description>IIS component registered through AppCmd configuration change</description>
    <mitre>
      <id>T1505.004</id>
    </mitre>
  </rule>
</group>
