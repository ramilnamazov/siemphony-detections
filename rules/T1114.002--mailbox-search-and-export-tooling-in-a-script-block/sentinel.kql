Event
| where (EventID == 4104 and (ScriptBlockText contains "Invoke-GlobalMailSearch" or ScriptBlockText contains "Invoke-SelfSearch" or ScriptBlockText contains "Invoke-OpenInboxFinder" or ScriptBlockText contains "Get-GlobalAddressList" or ScriptBlockText contains "Search-Mailbox" or ScriptBlockText contains "New-MailboxSearch" or ScriptBlockText contains "New-MailboxExportRequest" or ScriptBlockText contains "New-ComplianceSearchAction" or ScriptBlockText contains "Get-MgUserMessage" or ScriptBlockText contains "Get-MgUserMailFolderMessage" or ScriptBlockText contains "Microsoft.Exchange.WebServices" or ScriptBlockText contains "AADInternals"))
