index=* ((Image="*\\sc.exe" AND CommandLine="*query*") OR (Image="*\\tasklist.exe" AND (CommandLine="*-svc*" OR CommandLine="*/svc*" OR CommandLine="*–svc*" OR CommandLine="*—svc*" OR CommandLine="*―svc*")) OR ((Image="*\\net.exe" OR Image="*\\net1.exe") AND CommandLine="* start") OR (Image="*\\wmic.exe" AND CommandLine="*service*") OR (CommandLine="*Get-Service*" OR CommandLine="*Get-CimInstance -ClassName Win32_Service*" OR CommandLine="*Get-CimInstance Win32_Service*" OR CommandLine="*Get-WmiObject -Class Win32_Service*" OR CommandLine="*Get-WmiObject Win32_Service*"))
