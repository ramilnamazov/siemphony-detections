FROM logs-*
| WHERE ((TO_LOWER(type) == "path" AND (TO_LOWER(name) LIKE "/dev/sd*" OR TO_LOWER(name) LIKE "/dev/nvme*" OR TO_LOWER(name) LIKE "/dev/vd*" OR TO_LOWER(name) LIKE "/dev/xvd*" OR TO_LOWER(name) LIKE "/dev/hd*" OR TO_LOWER(name) LIKE "/dev/mmcblk*" OR TO_LOWER(name) LIKE "/dev/md*" OR TO_LOWER(name) LIKE "/dev/dm-*" OR TO_LOWER(name) LIKE "/dev/mapper/*" OR TO_LOWER(name) LIKE "/dev/disk/*")) OR (TO_LOWER(type) == "syscall" AND (TO_LOWER(exe) LIKE "*/dd" OR TO_LOWER(exe) LIKE "*/shred" OR TO_LOWER(exe) LIKE "*/wipe" OR TO_LOWER(exe) LIKE "*/nwipe" OR TO_LOWER(exe) LIKE "*/scrub" OR TO_LOWER(exe) LIKE "*/blkdiscard" OR TO_LOWER(exe) LIKE "*/badblocks")))
