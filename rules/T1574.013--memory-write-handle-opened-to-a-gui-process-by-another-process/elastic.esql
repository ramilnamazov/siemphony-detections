FROM logs-*
| WHERE ((TO_LOWER(GrantedAccess) == "0x1f0fff" OR TO_LOWER(GrantedAccess) == "0x1f1fff" OR TO_LOWER(GrantedAccess) == "0x1f2fff" OR TO_LOWER(GrantedAccess) == "0x1f3fff" OR TO_LOWER(GrantedAccess) == "0x1fffff" OR TO_LOWER(GrantedAccess) == "0x1438" OR TO_LOWER(GrantedAccess) == "0x438" OR TO_LOWER(GrantedAccess) == "0x1428" OR TO_LOWER(GrantedAccess) == "0x428") AND (TO_LOWER(TargetImage) LIKE "*\\\\explorer.exe" OR TO_LOWER(TargetImage) LIKE "*\\\\notepad.exe" OR TO_LOWER(TargetImage) LIKE "*\\\\mspaint.exe" OR TO_LOWER(TargetImage) LIKE "*\\\\wordpad.exe" OR TO_LOWER(TargetImage) LIKE "*\\\\calc.exe"))
