<group name="sigma,windows,registry_set,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <!-- 2 rules: the Sigma condition ORs across different fields,
       which one rule cannot express. Any one matching is a hit. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="TargetObject" type="pcre2">(?i)\\NetworkProvider\\ProviderPath$</field>
    <field name="Details" negate="yes" type="pcre2">(?i)(\\System32\\|\\SysWOW64\\)</field>
    <description>Network provider DLL registered in the registry (1/2)</description>
    <mitre>
      <id>T1556.008</id>
    </mitre>
  </rule>

  <rule id="100001" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="TargetObject" type="pcre2">(?i)(\\NetworkProvider\\Order\\ProviderOrder$|\\NetworkProvider\\HwOrder\\ProviderOrder$)</field>
    <description>Network provider DLL registered in the registry (2/2)</description>
    <mitre>
      <id>T1556.008</id>
    </mitre>
  </rule>
</group>
