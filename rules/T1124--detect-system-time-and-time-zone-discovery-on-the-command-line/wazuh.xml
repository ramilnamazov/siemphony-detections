<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)(w32tm /tz|w32tm -tz|w32tm /query /status|net time \\|tzutil /g|tzutil -g|Get-TimeZone|\[System\.TimeZoneInfo\]|Get-Date -Format)</field>
    <description>Detect system time and time zone discovery on the command line</description>
    <mitre>
      <id>T1124</id>
    </mitre>
  </rule>
</group>
