FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*\\\\powershell.exe" OR TO_LOWER(process.executable) LIKE "*\\\\pwsh.exe" OR TO_LOWER(process.executable) LIKE "*\\\\cscript.exe" OR TO_LOWER(process.executable) LIKE "*\\\\wscript.exe" OR TO_LOWER(process.executable) LIKE "*\\\\mshta.exe" OR TO_LOWER(process.executable) LIKE "*\\\\certutil.exe" OR TO_LOWER(process.executable) LIKE "*\\\\curl.exe" OR TO_LOWER(process.executable) LIKE "*\\\\python.exe" OR TO_LOWER(process.executable) LIKE "*\\\\pythonw.exe" OR TO_LOWER(process.executable) LIKE "*\\\\rclone.exe" OR TO_LOWER(process.executable) LIKE "*\\\\git-remote-https.exe") AND (TO_LOWER(dns.question.name) LIKE "*github.com" OR TO_LOWER(dns.question.name) LIKE "*githubusercontent.com" OR TO_LOWER(dns.question.name) LIKE "*gitlab.com" OR TO_LOWER(dns.question.name) LIKE "*bitbucket.org" OR TO_LOWER(dns.question.name) LIKE "*sourceforge.net"))
