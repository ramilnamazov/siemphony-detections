<group name="sigma,windows,dns_query,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\powershell\.exe$|\\pwsh\.exe$|\\cscript\.exe$|\\wscript\.exe$|\\mshta\.exe$|\\certutil\.exe$|\\curl\.exe$|\\python\.exe$|\\pythonw\.exe$|\\rclone\.exe$|\\git-remote-https\.exe$)</field>
    <field name="QueryName" type="pcre2">(?i)(github\.com$|githubusercontent\.com$|gitlab\.com$|bitbucket\.org$|sourceforge\.net$)</field>
    <description>Code repository domain resolved by a script host or transfer tool</description>
    <mitre>
      <id>T1567.001</id>
    </mitre>
  </rule>
</group>
