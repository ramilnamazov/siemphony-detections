DeviceProcessEvents
| where (((FolderPath endswith "\\sc.exe" or FolderPath endswith "\\net.exe" or FolderPath endswith "\\net1.exe" or FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") and (ProcessCommandLine contains " stop " or ProcessCommandLine contains "Stop-Service" or ProcessCommandLine contains "start= disabled" or ProcessCommandLine contains "start=disabled")) and (ProcessCommandLine contains "MSExchangeIS" or ProcessCommandLine contains "MSExchangeTransport" or ProcessCommandLine contains "MSSQLSERVER" or ProcessCommandLine contains "SQLSERVERAGENT" or ProcessCommandLine contains "W3SVC"))
