<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="Image" type="pcre2">(?i)(\\sc\.exe$|\\net\.exe$|\\net1\.exe$|\\powershell\.exe$|\\pwsh\.exe$)</field>
    <field name="CommandLine" type="pcre2">(?i)( stop |Stop-Service|start= disabled|start=disabled)</field>
    <field name="CommandLine" type="pcre2">(?i)(MSExchangeIS|MSExchangeTransport|MSSQLSERVER|SQLSERVERAGENT|W3SVC)</field>
    <description>Stop or disable command targeting a data-store service</description>
    <mitre>
      <id>T1489</id>
    </mitre>
  </rule>
</group>
