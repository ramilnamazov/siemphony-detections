FROM logs-*
| WHERE (((TO_LOWER(process.executable) LIKE "*/sh" OR TO_LOWER(process.executable) LIKE "*/bash" OR TO_LOWER(process.executable) LIKE "*/dash" OR TO_LOWER(process.executable) LIKE "*/ash") AND (TO_LOWER(process.command_line) LIKE "*sleep *" OR TO_LOWER(process.command_line) LIKE "*ping *")) AND (TO_LOWER(process.command_line) LIKE "*curl*" OR TO_LOWER(process.command_line) LIKE "*wget*" OR TO_LOWER(process.command_line) LIKE "*|sh*" OR TO_LOWER(process.command_line) LIKE "*| sh*" OR TO_LOWER(process.command_line) LIKE "*|bash*" OR TO_LOWER(process.command_line) LIKE "*| bash*"))
