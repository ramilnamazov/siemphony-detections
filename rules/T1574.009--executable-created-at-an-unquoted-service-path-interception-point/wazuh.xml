<group name="sigma,windows,file_event,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="TargetFilename" type="pcre2">(?i)(:\\Program\.exe$|:\\Program Files\.exe$|:\\Documents\.exe$|\\Program Files\\Common\.exe$|\\Program Files \(x86\)\\Common\.exe$)</field>
    <description>Executable created at an unquoted service path interception point</description>
    <mitre>
      <id>T1574.009</id>
    </mitre>
  </rule>
</group>
