FROM logs-*
| WHERE ((TO_LOWER(process.executable) LIKE "*\\\\wevtutil.exe" AND (TO_LOWER(process.command_line) LIKE "* cl *" OR TO_LOWER(process.command_line) LIKE "* clear-log *")) OR (TO_LOWER(process.command_line) LIKE "*remove-eventlog*" OR TO_LOWER(process.command_line) LIKE "*clear-eventlog*"))
