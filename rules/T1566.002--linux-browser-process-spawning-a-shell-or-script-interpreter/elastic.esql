FROM logs-*
| WHERE ((TO_LOWER(process.parent.executable) LIKE "*/firefox" OR TO_LOWER(process.parent.executable) LIKE "*/firefox-bin" OR TO_LOWER(process.parent.executable) LIKE "*/chrome" OR TO_LOWER(process.parent.executable) LIKE "*/google-chrome" OR TO_LOWER(process.parent.executable) LIKE "*/chromium" OR TO_LOWER(process.parent.executable) LIKE "*/chromium-browser") AND (TO_LOWER(process.executable) LIKE "*/bash" OR TO_LOWER(process.executable) LIKE "*/sh" OR TO_LOWER(process.executable) LIKE "*/dash" OR TO_LOWER(process.executable) LIKE "*/zsh" OR TO_LOWER(process.executable) LIKE "*/python3" OR TO_LOWER(process.executable) LIKE "*/python" OR TO_LOWER(process.executable) LIKE "*/perl"))
