<group name="sigma,linux,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="5">
    <!-- Set <if_sid> to the decoder/base rule for linux so this only evaluates relevant events. -->
    <field name="ParentImage" type="pcre2">(?i)(/firefox$|/firefox-bin$|/chrome$|/google-chrome$|/chromium$|/chromium-browser$)</field>
    <field name="Image" type="pcre2">(?i)(/bash$|/sh$|/dash$|/zsh$|/python3$|/python$|/perl$)</field>
    <description>Linux browser process spawning a shell or script interpreter</description>
    <mitre>
      <id>T1566.002</id>
    </mitre>
  </rule>
</group>
