FROM logs-*
| WHERE ((event.code == 4624 AND winlog.event_data.LogonType == 10 AND TO_LOWER(winlog.event_data.LogonProcessName) == "ntlmssp") OR (event.code == 4648 AND (TO_LOWER(winlog.event_data.ProcessName) LIKE "*\\\\mstsc.exe" OR TO_LOWER(winlog.event_data.ProcessName) LIKE "*\\\\wmic.exe" OR TO_LOWER(winlog.event_data.ProcessName) LIKE "*\\\\winrs.exe" OR TO_LOWER(winlog.event_data.ProcessName) LIKE "*\\\\powershell.exe" OR TO_LOWER(winlog.event_data.ProcessName) LIKE "*\\\\pwsh.exe" OR TO_LOWER(winlog.event_data.ProcessName) LIKE "*\\\\psexec.exe" OR TO_LOWER(winlog.event_data.ProcessName) LIKE "*\\\\psexec64.exe")))
