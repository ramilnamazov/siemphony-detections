FROM logs-*
| WHERE ((event.code == 4624 AND LogonType == 10 AND TO_LOWER(LogonProcessName) == "ntlmssp") OR (event.code == 4648 AND (TO_LOWER(ProcessName) LIKE "*\\\\mstsc.exe" OR TO_LOWER(ProcessName) LIKE "*\\\\wmic.exe" OR TO_LOWER(ProcessName) LIKE "*\\\\winrs.exe" OR TO_LOWER(ProcessName) LIKE "*\\\\powershell.exe" OR TO_LOWER(ProcessName) LIKE "*\\\\pwsh.exe" OR TO_LOWER(ProcessName) LIKE "*\\\\psexec.exe" OR TO_LOWER(ProcessName) LIKE "*\\\\psexec64.exe")))
