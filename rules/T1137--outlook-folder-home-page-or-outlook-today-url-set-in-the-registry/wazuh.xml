<group name="sigma,windows,registry_set,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="TargetObject" type="pcre2">(?i)(\\Outlook\\WebView\\|\\Outlook\\Today\\UserDefinedUrl|\\Outlook\\Security\\EnableRoamingFolderHomepages)</field>
    <description>Outlook folder home page or Outlook Today URL set in the registry</description>
    <mitre>
      <id>T1137</id>
      <id>T1137.004</id>
    </mitre>
  </rule>
</group>
