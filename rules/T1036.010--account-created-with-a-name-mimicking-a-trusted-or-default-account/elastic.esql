FROM logs-*
| WHERE (event.code == 4720 AND (TO_LOWER(winlog.event_data.TargetUserName) LIKE "*admin*" OR TO_LOWER(winlog.event_data.TargetUserName) LIKE "*help*" OR TO_LOWER(winlog.event_data.TargetUserName) LIKE "*root*" OR TO_LOWER(winlog.event_data.TargetUserName) LIKE "*backup*" OR TO_LOWER(winlog.event_data.TargetUserName) LIKE "*service*" OR TO_LOWER(winlog.event_data.TargetUserName) LIKE "*adm1n*" OR TO_LOWER(winlog.event_data.TargetUserName) LIKE "*backup_help*"))
