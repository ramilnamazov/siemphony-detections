FROM logs-*
| WHERE (((((event.code == 4656 OR event.code == 4670) AND TO_LOWER(winlog.event_data.ObjectType) == "key") AND TO_LOWER(winlog.event_data.ObjectName) LIKE "*\\\\microsoft\\\\office\\\\*") AND (TO_LOWER(winlog.event_data.ObjectName) LIKE "*\\\\word\\\\security*" OR TO_LOWER(winlog.event_data.ObjectName) LIKE "*\\\\excel\\\\security*")) AND NOT (TO_LOWER(winlog.event_data.ObjectName) LIKE "*\\\\policies\\\\microsoft\\\\office*"))
