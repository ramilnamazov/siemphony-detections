FROM logs-*
| WHERE ((event.code == 4728 OR event.code == 4732 OR event.code == 4756) AND (TO_LOWER(TargetSid) LIKE "*-512" OR TO_LOWER(TargetSid) LIKE "*-518" OR TO_LOWER(TargetSid) LIKE "*-519" OR TO_LOWER(TargetSid) LIKE "*-520" OR TO_LOWER(TargetSid) LIKE "*-544" OR TO_LOWER(TargetSid) LIKE "*-548" OR TO_LOWER(TargetSid) LIKE "*-549" OR TO_LOWER(TargetSid) LIKE "*-550" OR TO_LOWER(TargetSid) LIKE "*-551" OR TO_LOWER(TargetSid) LIKE "*-555" OR TO_LOWER(TargetSid) LIKE "*-580"))
