<group name="sigma,windows,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="7">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="EventID" type="pcre2">(?i)(^4728$|^4732$|^4756$)</field>
    <field name="TargetSid" type="pcre2">(?i)(-512$|-518$|-519$|-520$|-544$|-548$|-549$|-550$|-551$|-555$|-580$)</field>
    <description>Account added to a privileged local or domain group</description>
    <mitre>
      <id>T1098.007</id>
    </mitre>
  </rule>
</group>
