<group name="sigma,windows,process_creation,">
  <!-- Rule ids must be unique on your manager; 100000+ is the user range. -->
  <rule id="100000" level="12">
    <!-- Set <if_sid> to the decoder/base rule for windows so this only evaluates relevant events. -->
    <field name="CommandLine" type="pcre2">(?i)(SECURITY\\Policy\\Secrets|HKLM\\SECURITY\\Policy|HKLM:\\SECURITY\\Policy|lsadump::secrets|lsadump::lsa|Invoke-Mimikatz)</field>
    <description>LSA Policy Secrets subkey or LSA dumper module invoked</description>
    <mitre>
      <id>T1003.004</id>
    </mitre>
  </rule>
</group>
